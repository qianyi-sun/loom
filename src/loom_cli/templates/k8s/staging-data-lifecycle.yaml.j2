{% if runtime_environment == "staging" %}
apiVersion: batch/v1
kind: CronJob
metadata:
  name: loom-staging-data-lifecycle
  labels: { app: loom-staging-data-lifecycle }
spec:
  schedule: "*/5 * * * *"
  concurrencyPolicy: Forbid
  startingDeadlineSeconds: 120
  successfulJobsHistoryLimit: 1
  failedJobsHistoryLimit: 3
  jobTemplate:
    spec:
      backoffLimit: 0
      activeDeadlineSeconds: 1200
      ttlSecondsAfterFinished: 86400
      template:
        metadata:
          labels: { app: loom-staging-data-lifecycle }
        spec:
          automountServiceAccountToken: false
          restartPolicy: Never
          securityContext:
            runAsNonRoot: true
            seccompProfile: { type: RuntimeDefault }
          containers:
            - name: lifecycle
              image: {% if container_registry %}{{ container_registry }}/{% endif %}loom-control-plane:{{ image_tag }}
              command: ["python", "-I", "-B", "-m", "loom.data_lifecycle_maintenance"]
              args:
                - --namespace
                - {{ namespace }}
                - --bucket
                - trajectories
                - --bucket
                - artifacts
{% if topology.multi_node %}
{% for replica in range(topology.minio_replicas) %}
                - --filesystem-path
                - /var/lib/loom-minio-capacity/{{ replica }}
{% endfor %}
{% else %}
                - --filesystem-path
                - /var/lib/loom-minio-capacity/0
{% endif %}
              env:
                - name: LOOM_LIFECYCLE_DB_URL
                  valueFrom:
                    secretKeyRef: { name: loom-secrets, key: cp-db-url }
                - name: LOOM_LIFECYCLE_MINIO_ENDPOINT
                  value: "http://loom-minio:9000"
                - name: LOOM_LIFECYCLE_MINIO_ACCESS_KEY
                  valueFrom:
                    secretKeyRef: { name: loom-secrets, key: minio-access-key }
                - name: LOOM_LIFECYCLE_MINIO_SECRET_KEY
                  valueFrom:
                    secretKeyRef: { name: loom-secrets, key: minio-secret-key }
                - name: LOOM_LIFECYCLE_MINIO_REGION
                  value: "us-east-1"
                - name: LOOM_LIFECYCLE_STORAGE_AUTH_KIND
                  value: "static_keys"
              securityContext:
                allowPrivilegeEscalation: false
                capabilities: { drop: ["ALL"] }
                readOnlyRootFilesystem: true
              resources:
                requests: { cpu: 100m, memory: 128Mi }
                limits: { cpu: 1, memory: 1Gi }
              volumeMounts:
{% if topology.multi_node %}
{% for replica in range(topology.minio_replicas) %}
                - name: minio-capacity-{{ replica }}
                  mountPath: /var/lib/loom-minio-capacity/{{ replica }}
                  readOnly: true
{% endfor %}
{% else %}
                - name: minio-capacity-0
                  mountPath: /var/lib/loom-minio-capacity/0
                  readOnly: true
{% endif %}
          volumes:
{% if topology.multi_node %}
{% for replica in range(topology.minio_replicas) %}
            - name: minio-capacity-{{ replica }}
              persistentVolumeClaim:
                claimName: data-loom-minio-{{ replica }}
                readOnly: true
{% endfor %}
{% else %}
            - name: minio-capacity-0
              persistentVolumeClaim:
                claimName: data-loom-minio-0
                readOnly: true
{% endif %}
{% endif %}
