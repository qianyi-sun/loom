{% import "_env.j2" as env_macros %}
apiVersion: apps/v1
kind: Deployment
metadata:
  name: loom-family-orchestrator
spec:
  replicas: 1
  selector:
    matchLabels: { app: loom-family-orchestrator }
  template:
    metadata:
      labels: { app: loom-family-orchestrator }
    spec:
      containers:
        - name: family-orchestrator
          image: {% if container_registry %}{{ container_registry }}/{% endif %}loom-family-orchestrator:{{ image_tag }}
          {{ env_macros.env_block("control-plane", schema, override_values={"artifacts_bucket": artifacts_bucket, "trajectories_bucket": trajectories_bucket}) | indent(10) }}
            - name: LOOM_CP_ADMIN_SECRET_FILE
              value: "/var/run/loom/secrets/admin/secrets.toml"
            - name: LOOM_ENV
              value: "{{ runtime_environment }}"
            # Dedicated family:cancel + family:evolve credential. Cancellation
            # stays at the Control Plane; evolution exchanges this credential
            # for a real trial/team/provider-bound step JWT. The credential is
            # never sent to the Gateway directly.
            - name: LOOM_FAMILY_ORCHESTRATOR_GATEWAY_TOKEN
              valueFrom:
                secretKeyRef:
                  name: loom-secrets
                  key: family-orchestrator-token
                  optional: true
          volumeMounts:
            - name: loom-admin-secret
              mountPath: /var/run/loom/secrets/admin
              readOnly: true
          resources:
            requests: { cpu: 100m, memory: 128Mi }
            limits: { cpu: 500m, memory: 512Mi }
      volumes:
        - name: loom-admin-secret
          secret:
            secretName: loom-admin-secret
            defaultMode: 0400
