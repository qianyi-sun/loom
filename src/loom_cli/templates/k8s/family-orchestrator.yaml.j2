{% import "_env.j2" as env_macros %}
apiVersion: apps/v1
kind: Deployment
metadata:
  name: loom-family-orchestrator
spec:
  replicas: 1
  selector:
    matchLabels: { app: loom-family-orchestrator }
  template:
    metadata:
      labels: { app: loom-family-orchestrator }
    spec:
      containers:
        - name: family-orchestrator
          image: {% if container_registry %}{{ container_registry }}/{% endif %}loom-family-orchestrator:{{ image_tag }}
          {{ env_macros.env_block("control-plane", schema) | indent(10) }}
            - name: LOOM_CP_ADMIN_SECRET_FILE
              value: "/var/run/loom/secrets/admin/secrets.toml"
            - name: LOOM_ENV
              value: "{{ runtime_environment }}"
            # #672 blocker #697: BYO gateway credentials for the
            # skill_patcher_llm adapter. Read straight from env (not
            # via ControlPlaneSettings) so the orchestrator falls back
            # cleanly when the operator hasn't provisioned them —
            # the family-run loop still advances non-LLM adapters.
            - name: LOOM_FAMILY_ORCHESTRATOR_GATEWAY_TEAM_ID
              valueFrom:
                secretKeyRef:
                  name: loom-secrets
                  key: family-orchestrator-team-id
                  optional: true
            - name: LOOM_FAMILY_ORCHESTRATOR_GATEWAY_TOKEN
              valueFrom:
                secretKeyRef:
                  name: loom-secrets
                  key: family-orchestrator-token
                  optional: true
          volumeMounts:
            - name: loom-admin-secret
              mountPath: /var/run/loom/secrets/admin
              readOnly: true
          resources:
            requests: { cpu: 100m, memory: 128Mi }
            limits: { cpu: 500m, memory: 512Mi }
      volumes:
        - name: loom-admin-secret
          secret:
            secretName: loom-admin-secret
            defaultMode: 0400
