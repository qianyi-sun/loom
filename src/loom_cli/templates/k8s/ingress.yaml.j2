apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: loom-ingress
  annotations:
    # Adjust to match your cluster's ingress controller (nginx, traefik,
    # gke-ingress, alb, etc.). Defaults assume nginx.
    nginx.ingress.kubernetes.io/proxy-body-size: "100m"
spec:
  rules:
    # On `{{ ingress_host }}`:
    #   /api/v1/*  → loom_service (REST surface mounted at /api/v1/*)
    #   anything else → loom_web (React SPA; nginx falls back to
    #                   index.html for client-side React Router paths)
    #
    # Path order matters: more-specific `/api/v1` MUST precede the
    # catch-all `/`. Nginx ingress evaluates Prefix paths longest-first
    # by default, but listing in this order keeps it obvious to humans.
    - host: {{ ingress_host }}
      http:
        paths:
          - path: /api/v1
            pathType: Prefix
            backend:
              service:
                name: loom-service
                port:
                  number: 8090
          - path: /
            pathType: Prefix
            backend:
              service:
                name: loom-web
                port:
                  number: 80
{% if gateway_public_host %}
    # LLM Gateway is exposed at its own host because agents inside
    # sandboxes need a stable URL to call from outside the cluster.
    # Bearer auth is enforced at the route level.
    # Opt-in via `gateway_public_host` config; default install keeps
    # the gateway internal-only (#77 boundary enforcement).
    - host: {{ gateway_public_host }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: loom-llm-gateway
                port:
                  number: 9100
{% endif %}
  # NOTE: the Control Plane (`loom-control-plane:8080`) is intentionally
  # NOT exposed via Ingress. It carries worker-only routes
  # (`POST /trials/claim`, `PATCH /trials/{id}/state`) and admin
  # endpoints (`POST /admin/worker-tokens`) that should only be
  # reachable from inside the cluster. Workers + `loom_service`
  # reach the CP through cluster DNS (`http://loom-control-plane:8080`).
  # For operator-side admin curls, port-forward:
  #   kubectl port-forward deploy/loom-control-plane 8080:8080
