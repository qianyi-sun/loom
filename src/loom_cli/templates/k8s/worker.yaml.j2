{% import "_env.j2" as env_macros %}
{# When k8s_worker.enabled is false the whole loom-worker workload
   is omitted from the rendered manifest. Protected static-host-path
   profiles still render the trajectories PVC so the retained PV/PVC
   boundary exists before protected preflight.
   Trial execution capacity for these profiles comes from external
   Slurm-managed pools. See #383 and #554.

   Dynamic-storage profiles render loom-worker as a StatefulSet with
   volumeClaimTemplates so each replica gets its own RWO PVC. RWO
   Longhorn volumes can only attach to one node at a time, which
   blocks scaling a Deployment past 1 replica on multi-node k3s.
   See #673. Static-host-path profiles keep the single-replica
   Deployment shape (retained PV bound to a fixed-name PVC). #}
{% if k8s_worker.enabled %}
apiVersion: apps/v1
{% if static_host_path_storage %}
kind: Deployment
{% else %}
kind: StatefulSet
{% endif %}
metadata:
  name: loom-worker
spec:
  replicas: {{ replicas.worker }}
{% if not static_host_path_storage %}
  serviceName: loom-worker
  podManagementPolicy: Parallel
{% endif %}
  selector:
    matchLabels: { app: loom-worker }
  template:
    metadata:
      labels: { app: loom-worker }
    spec:
      containers:
        - name: worker
          image: {% if container_registry %}{{ container_registry }}/{% endif %}loom-worker:{{ image_tag }}
          {{ env_macros.env_block("worker", schema, skip_names=("max_concurrent", "pool_name"), override_values={"trial_cache_registry_repo": trial_cache_registry_repo, "artifacts_bucket": artifacts_bucket, "trajectories_bucket": trajectories_bucket}) | indent(10) }}
            - name: LOOM_WORKER_MAX_CONCURRENT
              value: {{ worker_capacity.max_concurrent | string | tojson }}
            - name: LOOM_WORKER_POOL_NAME
              value: "k8s-worker"
            # Subprocess agents run inside Docker sandboxes, not the worker pod.
            # They cannot resolve k8s Service DNS, so inject the operator-
            # selected sandbox-facing bridge URL.
            - name: LOOM_WORKER_SUBPROCESS_GATEWAY_URL
              value: {{ worker_subprocess_gateway_url | tojson }}
          volumeMounts:
            - name: trajectories
              mountPath: /var/lib/loom/trajectories
            - name: docker-sock
              # NOTE: bind-mounting the host docker socket has obvious
              # blast-radius implications. Production should swap this
              # for a rootless / sysbox / kata-containers runtime.
              #
              # On clusters running the Pod Security Admission
              # "restricted" profile (k8s 1.25+ default for new
              # namespaces), this hostPath mount is rejected outright.
              # You must either:
              #   (a) label the namespace
              #       pod-security.kubernetes.io/enforce=privileged,
              #   (b) move workers to a dedicated cluster, or
              #   (c) switch to a non-Docker driver (sysbox / kata).
              mountPath: /var/run/docker.sock
            - name: docker-config
              mountPath: /root/.docker
              readOnly: true
          resources:
            requests:
              cpu: {{ worker_capacity.cpu_request | tojson }}
              memory: {{ worker_capacity.memory_request | tojson }}
            limits:
              cpu: {{ worker_capacity.cpu_limit | tojson }}
              memory: {{ worker_capacity.memory_limit | tojson }}
      volumes:
{% if static_host_path_storage %}
        - name: trajectories
          persistentVolumeClaim:
            claimName: loom-worker-trajectories
{% endif %}
        - name: docker-sock
          hostPath:
            path: /var/run/docker.sock
            type: Socket
        - name: docker-config
          secret:
            secretName: docker-config
            optional: true
            items:
              - key: .dockerconfigjson
                path: config.json
{% if not static_host_path_storage %}
  volumeClaimTemplates:
    - metadata:
        name: trajectories
      spec:
        accessModes: [ ReadWriteOnce ]
        resources: { requests: { storage: {{ worker_trajectory_storage_gi }}Gi } }
---
# Headless Service required by the StatefulSet for stable per-pod
# DNS names (loom-worker-0.loom-worker, ...). No ClusterIP: workers
# do not receive inbound traffic — they poll the control plane.
apiVersion: v1
kind: Service
metadata:
  name: loom-worker
spec:
  clusterIP: None
  selector: { app: loom-worker }
{% endif %}
---
{% endif %}
{% if static_host_path_storage %}
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: loom-worker-trajectories
spec:
  accessModes: [ ReadWriteOnce ]
  storageClassName: ""
  volumeName: {{ worker_trajectories_pv_name }}
  resources: { requests: { storage: {{ worker_trajectory_storage_gi }}Gi } }
{% endif %}
