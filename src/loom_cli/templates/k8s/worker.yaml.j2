{% import "_env.j2" as env_macros %}
apiVersion: apps/v1
kind: Deployment
metadata:
  name: loom-worker
spec:
  replicas: {{ replicas.worker }}
  selector:
    matchLabels: { app: loom-worker }
  template:
    metadata:
      labels: { app: loom-worker }
    spec:
      containers:
        - name: worker
          image: loom-worker:{{ image_tag }}
          {{ env_macros.env_block("worker", schema, skip_names=("max_concurrent", "pool_name")) | indent(10) }}
            - name: LOOM_WORKER_MAX_CONCURRENT
              value: {{ worker_capacity.max_concurrent | string | tojson }}
            - name: LOOM_WORKER_POOL_NAME
              value: "k8s-worker"
            # Subprocess agents run inside Docker sandboxes, not the worker pod.
            # They cannot resolve k8s Service DNS, so inject the operator-
            # selected sandbox-facing bridge URL.
            - name: LOOM_WORKER_SUBPROCESS_GATEWAY_URL
              value: {{ worker_subprocess_gateway_url | tojson }}
          volumeMounts:
            - name: trajectories
              mountPath: /var/lib/loom/trajectories
            - name: docker-sock
              # NOTE: bind-mounting the host docker socket has obvious
              # blast-radius implications. Production should swap this
              # for a rootless / sysbox / kata-containers runtime.
              #
              # On clusters running the Pod Security Admission
              # "restricted" profile (k8s 1.25+ default for new
              # namespaces), this hostPath mount is rejected outright.
              # You must either:
              #   (a) label the namespace
              #       pod-security.kubernetes.io/enforce=privileged,
              #   (b) move workers to a dedicated cluster, or
              #   (c) switch to a non-Docker driver (sysbox / kata).
              mountPath: /var/run/docker.sock
            - name: docker-config
              mountPath: /root/.docker
              readOnly: true
          resources:
            requests:
              cpu: {{ worker_capacity.cpu_request | tojson }}
              memory: {{ worker_capacity.memory_request | tojson }}
            limits:
              cpu: {{ worker_capacity.cpu_limit | tojson }}
              memory: {{ worker_capacity.memory_limit | tojson }}
      volumes:
        - name: trajectories
          persistentVolumeClaim:
            claimName: loom-worker-trajectories
        - name: docker-sock
          hostPath:
            path: /var/run/docker.sock
            type: Socket
        - name: docker-config
          secret:
            secretName: docker-config
            optional: true
            items:
              - key: .dockerconfigjson
                path: config.json
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: loom-worker-trajectories
spec:
  accessModes: [ ReadWriteOnce ]
{% if static_host_path_storage %}
  storageClassName: ""
  volumeName: {{ worker_trajectories_pv_name }}
{% endif %}
  resources: { requests: { storage: {{ worker_trajectory_storage_gi }}Gi } }
