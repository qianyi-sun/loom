{% import "_env.j2" as env_macros %}
apiVersion: apps/v1
kind: Deployment
metadata:
  name: loom-worker
spec:
  replicas: {{ replicas.worker }}
  selector:
    matchLabels: { app: loom-worker }
  template:
    metadata:
      labels: { app: loom-worker }
    spec:
      containers:
        - name: worker
          image: loom-worker:{{ image_tag }}
          {{ env_macros.env_block("worker", schema) | indent(10) }}
            # Subprocess agents run inside Docker sandboxes, not the worker pod.
            # They cannot resolve k8s Service DNS, so use the node-local
            # gateway-router hostPort plus Docker's host-gateway alias.
            - name: LOOM_WORKER_SUBPROCESS_GATEWAY_URL
              value: http://host.docker.internal:30443/openai/v1
          volumeMounts:
            - name: trajectories
              mountPath: /var/lib/loom/trajectories
            - name: docker-sock
              # NOTE: bind-mounting the host docker socket has obvious
              # blast-radius implications. Production should swap this
              # for a rootless / sysbox / kata-containers runtime.
              #
              # On clusters running the Pod Security Admission
              # "restricted" profile (k8s 1.25+ default for new
              # namespaces), this hostPath mount is rejected outright.
              # You must either:
              #   (a) label the namespace
              #       pod-security.kubernetes.io/enforce=privileged,
              #   (b) move workers to a dedicated cluster, or
              #   (c) switch to a non-Docker driver (sysbox / kata).
              mountPath: /var/run/docker.sock
          resources:
            requests: { cpu: 500m, memory: 1Gi }
            limits: { cpu: 4, memory: 8Gi }
      volumes:
        - name: trajectories
          persistentVolumeClaim:
            claimName: loom-worker-trajectories
        - name: docker-sock
          hostPath:
            path: /var/run/docker.sock
            type: Socket
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: loom-worker-trajectories
spec:
  accessModes: [ ReadWriteOnce ]
  resources: { requests: { storage: {{ worker_trajectory_storage_gi }}Gi } }
