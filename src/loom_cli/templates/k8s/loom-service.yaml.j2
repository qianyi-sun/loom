{% import "_env.j2" as env_macros %}
apiVersion: apps/v1
kind: Deployment
metadata:
  name: loom-service
spec:
  replicas: {{ replicas.service }}
  selector:
    matchLabels: { app: loom-service }
  template:
    metadata:
      labels: { app: loom-service }
    spec:
      containers:
        - name: loom-service
          image: loom-service:{{ image_tag }}
          {{ env_macros.env_block("loom-service", schema) | indent(10) }}
            - name: LOOM_SVC_ADMIN_SECRET_FILE
              value: "/var/run/loom/secrets/admin/secrets.toml"
            - name: LOOM_ENV
              value: "production"
          volumeMounts:
            - name: loom-admin-secret
              mountPath: /var/run/loom/secrets/admin
              readOnly: true
          ports:
            - containerPort: 8090
          readinessProbe:
            httpGet: { path: /api/v1/health, port: 8090 }
            periodSeconds: 5
          resources:
            requests: { cpu: 200m, memory: 256Mi }
            limits: { cpu: 1, memory: 1Gi }
      volumes:
        - name: loom-admin-secret
          secret:
            secretName: loom-admin-secret
            defaultMode: 0400
---
apiVersion: v1
kind: Service
metadata:
  name: loom-service
spec:
  selector: { app: loom-service }
  ports:
    - port: 8090
      targetPort: 8090
