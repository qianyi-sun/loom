apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: loom-postgres
spec:
  serviceName: loom-postgres
  replicas: 1
  selector:
    matchLabels: { app: loom-postgres }
  template:
    metadata:
      labels: { app: loom-postgres }
    spec:
      containers:
        - name: postgres
          image: {{ postgres_image }}
          args: ["-c", "max_connections={{ postgres.max_connections }}"]
          env:
            - name: POSTGRES_USER
              valueFrom: { secretKeyRef: { name: loom-secrets, key: postgres-user } }
            - name: POSTGRES_PASSWORD
              valueFrom: { secretKeyRef: { name: loom-secrets, key: postgres-password } }
            - name: POSTGRES_DB
              value: loom
          ports:
            - containerPort: 5432
          volumeMounts:
            - name: data
              mountPath: /var/lib/postgresql/data
          readinessProbe:
            exec: { command: ["pg_isready", "-U", "loom"] }
            initialDelaySeconds: 5
            periodSeconds: 5
  volumeClaimTemplates:
    - metadata: { name: data }
      spec:
        accessModes: [ ReadWriteOnce ]
{% if static_host_path_storage %}
        storageClassName: ""
        volumeName: {{ postgres_pv_name }}
{% endif %}
        resources: { requests: { storage: {{ postgres_storage_gi }}Gi } }
---
apiVersion: v1
kind: Service
metadata:
  name: loom-postgres
spec:
  selector: { app: loom-postgres }
  ports:
    - port: 5432
      targetPort: 5432
