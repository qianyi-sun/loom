apiVersion: apps/v1
kind: Deployment
metadata:
  name: loom-llm-gateway
spec:
  replicas: {{ replicas.gateway }}
  selector:
    matchLabels: { app: loom-llm-gateway }
  template:
    metadata:
      labels: { app: loom-llm-gateway }
    spec:
      containers:
        - name: gateway
          image: loom-llm-gateway:{{ image_tag }}
          env:
            - name: LOOM_GW_DB_URL
              valueFrom: { secretKeyRef: { name: loom-secrets, key: gw-db-url } }
            - name: LOOM_GW_ANTHROPIC_API_KEY
              valueFrom: { secretKeyRef: { name: loom-secrets, key: anthropic-api-key } }
            - name: LOOM_GW_OPENAI_API_KEY
              valueFrom: { secretKeyRef: { name: loom-secrets, key: openai-api-key } }
          ports:
            - containerPort: 9100
          readinessProbe:
            httpGet: { path: /healthz, port: 9100 }
            periodSeconds: 5
          resources:
            requests: { cpu: 200m, memory: 256Mi }
            limits: { cpu: 1, memory: 1Gi }
---
apiVersion: v1
kind: Service
metadata:
  name: loom-llm-gateway
spec:
  selector: { app: loom-llm-gateway }
  ports:
    - port: 9100
      targetPort: 9100
