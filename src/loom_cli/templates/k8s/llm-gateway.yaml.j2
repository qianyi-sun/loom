{% import "_env.j2" as env_macros %}
apiVersion: apps/v1
kind: Deployment
metadata:
  name: loom-llm-gateway
spec:
  replicas: {{ replicas.gateway }}
  selector:
    matchLabels: { app: loom-llm-gateway }
  template:
    metadata:
      labels: { app: loom-llm-gateway }
    spec:
      containers:
        - name: gateway
          image: loom-llm-gateway:{{ image_tag }}
          {{ env_macros.env_block("llm-gateway", schema) | indent(10) }}
            - name: LOOM_GW_ADMIN_SECRET_FILE
              value: "/var/run/loom/admin/secrets.toml"
            - name: LOOM_SECRET_STORE_MASTER_KEY
              valueFrom:
                secretKeyRef:
                  name: loom-secrets
                  key: secret-store-master-key
            - name: LOOM_ENV
              value: "production"
          ports:
            - containerPort: 9100
          readinessProbe:
            httpGet: { path: /healthz, port: 9100 }
            periodSeconds: 5
          volumeMounts:
            - name: loom-admin-secret
              mountPath: /var/run/loom/admin
              readOnly: true
          resources:
            requests: { cpu: 200m, memory: 256Mi }
            limits: { cpu: 1, memory: 1Gi }
      volumes:
        - name: loom-admin-secret
          secret:
            secretName: loom-admin-secret
            defaultMode: 0600
---
apiVersion: v1
kind: Service
metadata:
  name: loom-llm-gateway
spec:
  selector: { app: loom-llm-gateway }
  ports:
    - port: 9100
      targetPort: 9100
