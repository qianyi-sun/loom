{% import "_env.j2" as env_macros %}
apiVersion: apps/v1
kind: Deployment
metadata:
  name: loom-control-plane
spec:
  replicas: {{ replicas.control_plane }}
  selector:
    matchLabels: { app: loom-control-plane }
  template:
    metadata:
      labels: { app: loom-control-plane }
{% if nebius_execution.enabled %}
      annotations:
        loom.ca/nebius-configuration-revision: {{ nebius_execution.configuration_revision | tojson }}
{% endif %}
    spec:
{% if runtime_environment == "staging" %}
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532
        runAsGroup: 65532
        fsGroup: 65532
        seccompProfile: { type: RuntimeDefault }
      initContainers:
        - name: protected-worker-runtime-init
          image: {% if container_registry %}{{ container_registry }}/{% endif %}loom-control-plane:{{ image_tag }}
          command:
            - /bin/sh
            - -euc
            - >-
              install -d -m 0700 /run/loom/protected-worker-runtime;
              chmod 0700 /run/loom/protected-worker-runtime;
              chmod g-s /run/loom/protected-worker-runtime;
              exec python -m loom.personal_dev_secret_init
              --profile staging-protected-worker-runtime
              --source /var/run/loom/protected-worker-runtime-projected
              --destination /run/loom/protected-worker-runtime/files
          securityContext:
            allowPrivilegeEscalation: false
            capabilities: { drop: ["ALL"] }
            readOnlyRootFilesystem: true
            runAsNonRoot: true
            runAsUser: 65532
          resources:
            requests: { cpu: 10m, memory: 16Mi }
            limits: { cpu: 100m, memory: 64Mi }
          volumeMounts:
            - name: protected-worker-runtime-projected
              mountPath: /var/run/loom/protected-worker-runtime-projected
              readOnly: true
            - name: protected-worker-runtime
              mountPath: /run/loom/protected-worker-runtime
{% endif %}
      containers:
        - name: control-plane
          image: {% if container_registry %}{{ container_registry }}/{% endif %}loom-control-plane:{{ image_tag }}
          {{ env_macros.env_block("control-plane", schema, skip_names=nebius_control_plane_skip_names, override_values=nebius_control_plane_overrides) | indent(10) }}
{% if nebius_execution.enabled %}
{% for suffix, key in nebius_source_secret_fields.items() %}
            - name: LOOM_CP_SERVICE_EXECUTION_SOURCE_{{ suffix }}
              valueFrom:
                secretKeyRef:
                  name: {{ nebius_execution.source_secret_name }}
                  key: {{ key }}
{% endfor %}
            - name: LOOM_CP_EXECUTION_IMAGE_ADMISSION_PUBLIC_KEYS_JSON
              valueFrom:
                secretKeyRef:
                  name: {{ nebius_execution.image_admission_secret_name }}
                  key: public-keys-json
{% endif %}
            - name: LOOM_CP_ADMIN_SECRET_FILE
              value: "/var/run/loom/secrets/admin/secrets.toml"
{% if runtime_environment == "staging" %}
            - name: LOOM_CP_PROTECTED_WORKER_RUNTIME_DB_URL_FILE
              value: "/run/loom/protected-worker-runtime/files/database-url"
{% endif %}
            - name: LOOM_ENV
              value: "{{ runtime_environment }}"
            - name: LOOM_NAMESPACE
              value: "{{ namespace }}"
{% if runtime_environment == "staging" %}
          securityContext:
            allowPrivilegeEscalation: false
            capabilities: { drop: ["ALL"] }
{% endif %}
          volumeMounts:
            - name: loom-admin-secret
              mountPath: /var/run/loom/secrets/admin
              readOnly: true
{% if runtime_environment == "staging" %}
            - name: protected-worker-runtime
              mountPath: /run/loom/protected-worker-runtime
              readOnly: true
{% endif %}
          ports:
            - containerPort: 8080
          readinessProbe:
            httpGet: { path: /healthz, port: 8080 }
            periodSeconds: 5
          resources:
            requests: { cpu: 200m, memory: 256Mi }
            limits: { cpu: 1, memory: 1Gi }
      volumes:
        - name: loom-admin-secret
          secret:
            secretName: loom-admin-secret
            defaultMode: 0400
{% if runtime_environment == "staging" %}
        - name: protected-worker-runtime-projected
          secret:
            secretName: loom-protected-worker-runtime
            defaultMode: 0440
            items:
              - key: ca.crt
                path: ca.crt
              - key: database-url
                path: database-url
        - name: protected-worker-runtime
          emptyDir:
            medium: Memory
            sizeLimit: 1Mi
{% endif %}
---
apiVersion: v1
kind: Service
metadata:
  name: loom-control-plane
spec:
  selector: { app: loom-control-plane }
  ports:
    - port: 8080
      targetPort: 8080
