{# CloudNativePG-managed Postgres cluster for multi-node HA (#637).

  Renders only when topology.multi_node = true. Requires the CloudNativePG
  operator (postgresql.cnpg.io/v1 CRDs) to be installed in the target
  cluster BEFORE this manifest is applied — the runbook covers the
  operator install. The Cluster CR asks CNPG to run
  topology.postgres_replicas Postgres pods with streaming replication,
  automatic failover, and PDB management handled by the operator.

  A companion ExternalName service `loom-postgres` bridges the DNS
  name that pgbouncer, Alembic, LISTEN watchers, and existing NetworkPolicy
  entries expect. CNPG creates loom-postgres-rw / loom-postgres-ro /
  loom-postgres-r automatically; we alias the -rw service back to
  `loom-postgres` so nothing else needs to change.

  Storage class is picked by topology.storage_backend:
  - "longhorn" (recommended for production) -> storageClassName: longhorn
  - "host_path" -> single-node local storage (unusual on multi_node=true
    but supported for testing on a single k3s node)
#}
{% if topology.multi_node %}
apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: loom-postgres
spec:
  instances: {{ topology.postgres_replicas }}
  # Intentionally NOT setting imageName: CNPG requires a specifically
  # patched Postgres image (ghcr.io/cloudnative-pg/postgresql:*) that
  # has the postgres UID 26 set up in /etc/passwd. The single-node
  # postgres_image (postgres:16) fails initdb inside CNPG with
  # "could not look up effective user ID 26". Letting CNPG pick its
  # bundled default image avoids the compatibility footgun. If a
  # specific major version needs pinning, add a topology.postgres_cnpg_image
  # schema field — do NOT reuse postgres_image which targets the
  # single-node vanilla shape.

  postgresql:
    parameters:
      max_connections: "{{ postgres.max_connections }}"
      # CNPG requires a few knobs raised to accommodate replication +
      # WAL shipping. Everything else stays at Postgres defaults so
      # this doesn't drift from the single-node shape.
      shared_buffers: "256MB"

  bootstrap:
    initdb:
      database: loom
      owner: loom
      secret:
        name: loom-postgres-cnpg-credentials

  # Reference existing loom-secrets so credential rotation stays a
  # single Secret. CNPG will read postgres-user / postgres-password
  # keys from the Secret named below.
  superuserSecret:
    name: loom-postgres-cnpg-credentials

  storage:
    size: {{ postgres_storage_gi }}Gi
{% if topology.storage_backend == "longhorn" %}
    storageClass: longhorn
{% elif topology.storage_backend == "host_path" %}
    storageClass: ""
{% endif %}

  affinity:
{% if topology.anti_affinity == "required" %}
    enablePodAntiAffinity: true
    topologyKey: kubernetes.io/hostname
    podAntiAffinityType: required
{% elif topology.anti_affinity == "preferred" %}
    enablePodAntiAffinity: true
    topologyKey: kubernetes.io/hostname
    podAntiAffinityType: preferred
{% endif %}

  # PodDisruptionBudget: CNPG manages the PDB automatically to enforce
  # minAvailable = instances - 1 (keep quorum during voluntary
  # disruption). No manual PDB needed.

  monitoring:
    enablePodMonitor: true

# The Secret `loom-postgres-cnpg-credentials` (kubernetes.io/basic-auth,
# keys `username` + `password`) is deliberately NOT rendered here. Its
# job is to carry the CNPG cluster's postgres credentials, and if we
# emitted a placeholder alongside the template, every `kubectl apply`
# would blow away the real credentials that the operator/runbook
# provisioned. It must be created out-of-band before applying the
# manifest — see the runbook step. Values should mirror
# `postgres-user` and `postgres-password` from `loom-secrets`:
#
#   kubectl create secret generic loom-postgres-cnpg-credentials \
#     --namespace {{ namespace }} \
#     --type kubernetes.io/basic-auth \
#     --from-literal=username=loom \
#     --from-literal=password=<same as postgres-password in loom-secrets>
---
# Backwards-compatibility Service: everything else in Loom (pgbouncer,
# LISTEN watchers, Alembic, NetworkPolicy selectors) expects a Service
# named `loom-postgres` on port 5432. CNPG creates {name}-rw for the
# primary; alias it via ExternalName so no other code needs to know
# about CNPG.
apiVersion: v1
kind: Service
metadata:
  name: loom-postgres
spec:
  type: ExternalName
  externalName: loom-postgres-rw.{{ namespace }}.svc.cluster.local
  ports:
    - port: 5432
      targetPort: 5432
      name: postgres
{% endif %}
