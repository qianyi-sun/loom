{
  "uid": "loom-control-plane",
  "title": "Loom — Control Plane Deep Dive",
  "tags": ["loom"],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active Workers",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 1, "color": "yellow" },
              { "value": 3, "color": "green" }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "loom_workers_active",
          "legendFormat": "active workers",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Trial State Transitions (rate 5m)",
      "gridPos": { "x": 4, "y": 0, "w": 20, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 2 }
        }
      },
      "targets": [
        {
          "expr": "sum by (to_state) (rate(loom_trials_state_total[5m]))",
          "legendFormat": "→ {{to_state}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Queue Depth — Top 10 Teams",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 50, "color": "yellow" },
              { "value": 100, "color": "red" }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "topk(10, sum by (team_id) (loom_queue_depth))",
          "legendFormat": "{{team_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "In-flight Trials per Team × State",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2 }
        }
      },
      "targets": [
        {
          "expr": "sum by (team_id, state) (loom_trials_inflight)",
          "legendFormat": "{{team_id}} / {{state}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Claim Latency P50 / P95 / P99",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 0.5, "color": "yellow" },
              { "value": 1.0, "color": "red" }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(loom_claim_latency_sec_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(loom_claim_latency_sec_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(loom_claim_latency_sec_bucket[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Claim Hit / Miss Ratio",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 2 }
        }
      },
      "targets": [
        {
          "expr": "sum by (result) (rate(loom_claim_latency_sec_count[5m]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "State PATCH Outcomes (ok / fenced / timeout)",
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 2 }
        }
      },
      "targets": [
        {
          "expr": "sum by (result) (rate(loom_state_patch_total[5m]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Worker Reclaim Rate",
      "gridPos": { "x": 12, "y": 24, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 0.1, "color": "yellow" },
              { "value": 0.5, "color": "red" }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "rate(loom_worker_reclaim_total[5m])",
          "legendFormat": "reclaim rate",
          "refId": "A"
        }
      ]
    },
    { "id": 9, "type": "timeseries", "title": "PipelineRuns by state/result", "gridPos": { "x": 0, "y": 32, "w": 12, "h": 8 }, "fieldConfig": { "defaults": { "unit": "short" } }, "targets": [{ "expr": "sum by (state,result_status) (loom_pipeline_runs)", "legendFormat": "{{state}} / {{result_status}}", "refId": "A" }] },
    { "id": 10, "type": "timeseries", "title": "StageRuns by state/resource", "gridPos": { "x": 12, "y": 32, "w": 12, "h": 8 }, "fieldConfig": { "defaults": { "unit": "short" } }, "targets": [{ "expr": "sum by (state,resource_class) (loom_pipeline_stage_runs)", "legendFormat": "{{state}} / {{resource_class}}", "refId": "A" }] },
    { "id": 11, "type": "timeseries", "title": "Attempts by state/resource", "gridPos": { "x": 0, "y": 40, "w": 12, "h": 8 }, "fieldConfig": { "defaults": { "unit": "short" } }, "targets": [{ "expr": "sum by (state,resource_class) (loom_execution_attempts)", "legendFormat": "{{state}} / {{resource_class}}", "refId": "A" }] },
    { "id": 12, "type": "timeseries", "title": "Stage duration p50/p95", "gridPos": { "x": 12, "y": 40, "w": 12, "h": 8 }, "fieldConfig": { "defaults": { "unit": "s" } }, "targets": [{ "expr": "histogram_quantile(0.50, sum by (le,resource_class) (rate(loom_pipeline_stage_duration_seconds_bucket[5m])))", "legendFormat": "p50 {{resource_class}}", "refId": "A" }, { "expr": "histogram_quantile(0.95, sum by (le,resource_class) (rate(loom_pipeline_stage_duration_seconds_bucket[5m])))", "legendFormat": "p95 {{resource_class}}", "refId": "B" }] },
    { "id": 13, "type": "timeseries", "title": "Settled GPU seconds rate", "gridPos": { "x": 0, "y": 48, "w": 12, "h": 8 }, "fieldConfig": { "defaults": { "unit": "s" } }, "targets": [{ "expr": "sum by (slurm_cluster,gpu_count_class) (rate(loom_pipeline_gpu_seconds_total[5m]))", "legendFormat": "{{slurm_cluster}} / {{gpu_count_class}}", "refId": "A" }] },
    { "id": 14, "type": "timeseries", "title": "Pipeline Artifact byte rate", "gridPos": { "x": 12, "y": 48, "w": 12, "h": 8 }, "fieldConfig": { "defaults": { "unit": "Bps" } }, "targets": [{ "expr": "sum by (artifact_class) (rate(loom_pipeline_artifact_bytes_total[5m]))", "legendFormat": "{{artifact_class}}", "refId": "A" }] },
    { "id": 15, "type": "timeseries", "title": "Cancellation p95 / forced", "gridPos": { "x": 0, "y": 56, "w": 12, "h": 8 }, "fieldConfig": { "defaults": { "unit": "s" } }, "targets": [{ "expr": "histogram_quantile(0.95, sum by (le,outcome) (rate(loom_pipeline_cancel_latency_seconds_bucket[5m])))", "legendFormat": "p95 {{outcome}}", "refId": "A" }, { "expr": "sum(increase(loom_pipeline_cancel_latency_seconds_count{outcome=\"forced\"}[15m]))", "legendFormat": "forced", "refId": "B" }] },
    { "id": 16, "type": "timeseries", "title": "Reconcile and commit failures", "gridPos": { "x": 12, "y": 56, "w": 12, "h": 8 }, "fieldConfig": { "defaults": { "unit": "short" } }, "targets": [{ "expr": "sum by (reason) (rate(loom_pipeline_controller_reconcile_errors_total[5m]))", "legendFormat": "reconcile {{reason}}", "refId": "A" }, { "expr": "sum by (commit_kind,reason) (rate(loom_pipeline_artifact_commit_failures_total[5m]))", "legendFormat": "{{commit_kind}} / {{reason}}", "refId": "B" }] },
    { "id": 17, "type": "timeseries", "title": "Stage queue/deadline age", "gridPos": { "x": 0, "y": 64, "w": 12, "h": 8 }, "fieldConfig": { "defaults": { "unit": "s" } }, "targets": [{ "expr": "max by (state,resource_class) (loom_pipeline_stage_queue_age_seconds)", "legendFormat": "queue {{state}} / {{resource_class}}", "refId": "A" }, { "expr": "max by (resource_class) (loom_pipeline_stage_deadline_overrun_seconds)", "legendFormat": "deadline {{resource_class}}", "refId": "B" }] },
    { "id": 18, "type": "timeseries", "title": "Checkpoint age", "gridPos": { "x": 12, "y": 64, "w": 12, "h": 8 }, "fieldConfig": { "defaults": { "unit": "s" } }, "targets": [{ "expr": "max by (resource_class) (loom_pipeline_checkpoint_oldest_age_seconds)", "legendFormat": "{{resource_class}}", "refId": "A" }] },
    { "id": 19, "type": "timeseries", "title": "Allocated GPU without process", "gridPos": { "x": 0, "y": 72, "w": 24, "h": 8 }, "fieldConfig": { "defaults": { "unit": "s" } }, "targets": [{ "expr": "max by (slurm_cluster,reason) (loom_pipeline_gpu_allocated_idle_seconds)", "legendFormat": "{{slurm_cluster}} / {{reason}}", "refId": "A" }] }
  ]
}
