# Trusted, credential-minimal BuildKit wrapper for personal development source.
#
# BuildKit v0.33.0-rc1 is the first upstream image whose buildctl/buildkitd
# embed x/crypto v0.55.0. Upstream RootlessKit still embeds a vulnerable
# x/crypto, so rebuild the reviewed v3.1.0 source commit with only that module
# raised to v0.55.0 and replace the base binary below.
FROM --platform=$BUILDPLATFORM golang:1.26-alpine3.23@sha256:b17af760035fc2f338eed92d448a6c67f2d45438844fc6c60678fa5f99e44b57 AS rootlesskit-builder

ARG TARGETOS
ARG TARGETARCH
WORKDIR /src/rootlesskit
ADD --checksum=sha256:51aa4e79847ce9ad48e76a7b824f13ab323b4b90bc13a692e9c8035b8da9340a \
    https://github.com/rootless-containers/rootlesskit/archive/62d2101fbbe4f79bc845a337c4e868d27ff602c9.tar.gz \
    /tmp/rootlesskit.tar.gz
RUN tar -xzf /tmp/rootlesskit.tar.gz --strip-components=1 \
    && go mod edit -require=golang.org/x/crypto@v0.55.0 \
    && go mod tidy \
    && CGO_ENABLED=0 GOOS="$TARGETOS" GOARCH="$TARGETARCH" \
       go build -trimpath -ldflags='-s -w' -o /out/rootlesskit ./cmd/rootlesskit \
    && go version -m /out/rootlesskit | grep -F 'golang.org/x/crypto' | grep -F 'v0.55.0' \
    && (cd /out && sha256sum rootlesskit > rootlesskit.sha256)

FROM moby/buildkit:v0.33.0-rc1-rootless@sha256:30fa7f6ebbbf482ba76d6a4ed63a7db0786dc43b81dd57fb62436a69d5ba84ab

ARG TARGETARCH
USER root
COPY --from=rootlesskit-builder /out/rootlesskit /usr/bin/rootlesskit
COPY --from=rootlesskit-builder /out/rootlesskit.sha256 /usr/share/loom/rootlesskit.sha256
COPY --chown=0:0 --chmod=0555 deploy/personal-dev-builder/loom-personal-dev-buildkitd /usr/local/bin/loom-personal-dev-buildkitd
RUN apk add --no-cache ca-certificates python3 \
    && test -x /usr/bin/buildctl \
    && test -x /usr/bin/buildkitd \
    && test -x /usr/bin/rootlesskit \
    && test "$(buildctl --version | awk '{print $3}')" = "v0.33.0-rc1" \
    && test "$(buildkitd --version | awk '{print $3}')" = "v0.33.0-rc1" \
    && test "$(rootlesskit --version)" = "rootlesskit version 3.1.0" \
    && (cd /usr/bin && sha256sum -c /usr/share/loom/rootlesskit.sha256) \
    && case "$TARGETARCH" in \
        amd64) qemu_path=/usr/bin/buildkit-qemu-aarch64 ;; \
        arm64) qemu_path=/usr/bin/buildkit-qemu-x86_64 ;; \
        *) exit 1 ;; \
    esac \
    && test -x "$qemu_path" \
    && test -x /bin/setpriv \
    && test -x /usr/bin/newuidmap \
    && test -x /usr/bin/newgidmap \
    && python3 -c "import os; expected={'/usr/bin/newuidmap':'0100000280000000000000000000000000000000','/usr/bin/newgidmap':'0100000240000000000000000000000000000000'}; observed={path:os.getxattr(path,'security.capability').hex() for path in expected}; assert observed == expected, observed" \
    && python3 -c "compile(open('/usr/local/bin/loom-personal-dev-buildkitd','rb').read(),'/usr/local/bin/loom-personal-dev-buildkitd','exec')"

WORKDIR /opt/loom-personal-dev-builder
COPY src/loom/__init__.py ./loom/__init__.py
COPY src/loom/personal_dev_builder_artifact.py ./loom/personal_dev_builder_artifact.py
COPY src/loom/personal_dev_candidate.py ./loom/personal_dev_candidate.py
COPY src/loom/personal_dev_sandbox_builder.py ./loom/personal_dev_sandbox_builder.py
COPY src/loom/personal_dev_source.py ./loom/personal_dev_source.py

RUN python3 -m compileall -q /opt/loom-personal-dev-builder \
    && chown -R 1000:1000 /opt/loom-personal-dev-builder

USER 1000:1000
ENV HOME=/workspace/home \
    PYTHONPATH=/opt/loom-personal-dev-builder \
    TMPDIR=/tmp

ENTRYPOINT ["python3", "-m", "loom.personal_dev_sandbox_builder"]
