# syntax=docker/dockerfile:1.20@sha256:26147acbda4f14c5add9946e2fd2ed543fc402884fd75146bd342a7f6271dc1d

# Trusted, credential-minimal BuildKit wrapper for personal development source.
#
# Keep the released v0.32.2 runtime filesystem, but rebuild its BuildKit
# binaries and the released RootlessKit v3.1.0 from checksum-bound source with
# the fixed golang.org/x/crypto dependency. The build toolchain, upstream
# commits, source archives, module version, and final architecture binaries are
# all fail-closed pins; candidate source cannot select any of them.
FROM --platform=$BUILDPLATFORM golang:1.26-alpine3.23@sha256:b17af760035fc2f338eed92d448a6c67f2d45438844fc6c60678fa5f99e44b57 AS patched-runtime

ARG TARGETOS
ARG TARGETARCH
ENV GOTOOLCHAIN=local \
    GOPROXY=https://proxy.golang.org,direct \
    GOSUMDB=sum.golang.org
RUN case "$(go version)" in "go version go1.26.7 linux/"*) ;; *) exit 1 ;; esac \
    && apk add --no-cache ca-certificates git

# moby/buildkit v0.32.2, signed tag commit 991535e0973488b6a429096d21fa13f81f2d89d8.
ADD --checksum=sha256:ebc242057b1eee67eb14ead8def52c3770c6793c8c8ac0c53d41983b085360f4 \
    https://github.com/moby/buildkit/archive/991535e0973488b6a429096d21fa13f81f2d89d8.tar.gz \
    /tmp/buildkit.tar.gz
RUN mkdir -p /out /src/buildkit \
    && tar -xzf /tmp/buildkit.tar.gz --strip-components=1 -C /src/buildkit
WORKDIR /src/buildkit
RUN go get golang.org/x/crypto@v0.55.0
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=0 GOOS="$TARGETOS" GOARCH="$TARGETARCH" \
    go build -mod=mod -trimpath -buildvcs=false \
      -ldflags "-X github.com/moby/buildkit/version.Version=v0.32.2-loom.1 -X github.com/moby/buildkit/version.Revision=991535e0973488b6a429096d21fa13f81f2d89d8 -X github.com/moby/buildkit/version.Package=github.com/moby/buildkit" \
      -o /out/buildctl ./cmd/buildctl
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=0 GOOS="$TARGETOS" GOARCH="$TARGETARCH" \
    go build -mod=mod -trimpath -buildvcs=false \
      -ldflags "-extldflags '-static' -X github.com/moby/buildkit/version.Version=v0.32.2-loom.1 -X github.com/moby/buildkit/version.Revision=991535e0973488b6a429096d21fa13f81f2d89d8 -X github.com/moby/buildkit/version.Package=github.com/moby/buildkit" \
      -tags "osusergo netgo static_build seccomp" \
      -o /out/buildkitd ./cmd/buildkitd

# rootless-containers/rootlesskit v3.1.0, signed tag commit
# 62d2101fbbe4f79bc845a337c4e868d27ff602c9.
ADD --checksum=sha256:51aa4e79847ce9ad48e76a7b824f13ab323b4b90bc13a692e9c8035b8da9340a \
    https://github.com/rootless-containers/rootlesskit/archive/62d2101fbbe4f79bc845a337c4e868d27ff602c9.tar.gz \
    /tmp/rootlesskit.tar.gz
RUN mkdir -p /src/rootlesskit \
    && tar -xzf /tmp/rootlesskit.tar.gz --strip-components=1 -C /src/rootlesskit
WORKDIR /src/rootlesskit
RUN go get golang.org/x/crypto@v0.55.0
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=0 GOOS="$TARGETOS" GOARCH="$TARGETARCH" \
    go build -mod=mod -trimpath -buildvcs=false \
      -o /out/rootlesskit ./cmd/rootlesskit

RUN required_version="v0.55.0" \
    && for binary in /out/buildctl /out/buildkitd /out/rootlesskit; do \
        test "$(go version -m "$binary" | sed -n '1s/.*: //p')" = "go1.26.7"; \
        go version -m "$binary" \
            | awk -v required="$required_version" \
                '$1 == "dep" && $2 == "golang.org/x/crypto" && $3 == required { found=1 } END { exit !found }'; \
    done

FROM moby/buildkit:rootless@sha256:504731e577c20559c00f968f33219f30115e70be29ab96728d1d06e963fc494b

ARG TARGETARCH
USER root
COPY --from=patched-runtime --chown=0:0 --chmod=0555 /out/buildctl /usr/bin/buildctl
COPY --from=patched-runtime --chown=0:0 --chmod=0555 /out/buildkitd /usr/bin/buildkitd
COPY --from=patched-runtime --chown=0:0 --chmod=0555 /out/rootlesskit /usr/bin/rootlesskit
COPY --chown=0:0 --chmod=0555 deploy/personal-dev-builder/loom-personal-dev-buildkitd /usr/local/bin/loom-personal-dev-buildkitd
RUN apk add --no-cache ca-certificates python3 \
    && test -x /usr/bin/buildctl \
    && test -x /usr/bin/buildkitd \
    && test -x /usr/bin/rootlesskit \
    && test "$(buildctl --version)" = "buildctl github.com/moby/buildkit v0.32.2-loom.1 991535e0973488b6a429096d21fa13f81f2d89d8" \
    && test "$(buildkitd --version)" = "buildkitd github.com/moby/buildkit v0.32.2-loom.1 991535e0973488b6a429096d21fa13f81f2d89d8" \
    && test "$(rootlesskit --version)" = "rootlesskit version 3.1.0" \
    && case "$TARGETARCH" in \
        amd64) buildctl_sha256=5c594a04284993e440e7d6fa8f007e15351df0118b3ee2f29e1a1baaf5a23a83; buildkitd_sha256=85a89191d7dc2ee53a06f54aaf7969df62092602e31b7dfbc008e1b67e6908c4; rootlesskit_sha256=ab942b0add070aa7ff4be0f366b5fd20c6c99a485f071556a59d5564c5d8841b; qemu_path=/usr/bin/buildkit-qemu-aarch64 ;; \
        arm64) buildctl_sha256=c2e0830c20f1122e671d24a5a4fe91b5ab71e8bae80fc650ebbffec3168e155b; buildkitd_sha256=6c117ff680f6b94f28cca78961c6bee3ff7b49fa1e159c2db63322e7f2ecd549; rootlesskit_sha256=3871394a3917b1c9d12f04f2d2296b9a870fb94be5d3ff812410777a77e922cd; qemu_path=/usr/bin/buildkit-qemu-x86_64 ;; \
        *) exit 1 ;; \
    esac \
    && test -x "$qemu_path" \
    && printf '%s  %s\n' \
        "$buildctl_sha256" /usr/bin/buildctl \
        "$buildkitd_sha256" /usr/bin/buildkitd \
        "$rootlesskit_sha256" \
        /usr/bin/rootlesskit | sha256sum -c - \
    && test -x /bin/setpriv \
    && test -x /usr/bin/newuidmap \
    && test -x /usr/bin/newgidmap \
    && python3 -c "import os; expected={'/usr/bin/newuidmap':'0100000280000000000000000000000000000000','/usr/bin/newgidmap':'0100000240000000000000000000000000000000'}; observed={path:os.getxattr(path,'security.capability').hex() for path in expected}; assert observed == expected, observed" \
    && python3 -c "compile(open('/usr/local/bin/loom-personal-dev-buildkitd','rb').read(),'/usr/local/bin/loom-personal-dev-buildkitd','exec')"

WORKDIR /opt/loom-personal-dev-builder
COPY src/loom/__init__.py ./loom/__init__.py
COPY src/loom/personal_dev_builder_artifact.py ./loom/personal_dev_builder_artifact.py
COPY src/loom/personal_dev_candidate.py ./loom/personal_dev_candidate.py
COPY src/loom/personal_dev_sandbox_builder.py ./loom/personal_dev_sandbox_builder.py
COPY src/loom/personal_dev_source.py ./loom/personal_dev_source.py

RUN python3 -m compileall -q /opt/loom-personal-dev-builder \
    && chown -R 1000:1000 /opt/loom-personal-dev-builder

USER 1000:1000
ENV HOME=/workspace/home \
    PYTHONPATH=/opt/loom-personal-dev-builder \
    TMPDIR=/tmp

ENTRYPOINT ["python3", "-m", "loom.personal_dev_sandbox_builder"]
