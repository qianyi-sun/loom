[Unit]
Description=Route public :443/:80 to the k3s ingress
Requires=loom-staging-public-proxy@18080-32080.service loom-staging-public-proxy@18443-32443.service
After=docker.service k3s.service network-online.target loom-staging-public-proxy@18080-32080.service loom-staging-public-proxy@18443-32443.service
Wants=docker.service k3s.service network-online.target
PartOf=docker.service k3s.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/loom-staging-k3s-cutover.sh
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=docker.service k3s.service multi-user.target
