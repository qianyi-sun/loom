# Agent-capable trial sandbox image.
#
# This image is intentionally separate from deploy/Dockerfile.worker. The
# worker container talks to Docker; SubprocessAgent runs external CLIs inside
# the task sandbox image selected by TaskConfig.environment.docker_image.

FROM node:22-bookworm-slim AS node-runtime

FROM python:3.12-slim

ENV PIP_BREAK_SYSTEM_PACKAGES=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1 \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_AUDIT=false

WORKDIR /workspace

COPY --from=node-runtime /usr/local/ /usr/local/
COPY deploy/agent-sandbox/npm-packages.txt /tmp/agent-sandbox/npm-packages.txt
COPY deploy/agent-sandbox/python-requirements.txt /tmp/agent-sandbox/python-requirements.txt
COPY deploy/agent-sandbox/python-cli-requirements.txt /tmp/agent-sandbox/python-cli-requirements.txt

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      bash \
      build-essential \
      ca-certificates \
      curl \
      git \
      gnupg \
      ripgrep \
      tini \
      tmux; \
    rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    npm install -g npm@12.0.2; \
    node --version; \
    npm --version; \
    python --version

RUN set -eux; \
    npm install -g $(grep -vE '^\s*(#|$)' /tmp/agent-sandbox/npm-packages.txt)

RUN set -eux; \
    python -m pip install --upgrade pip setuptools wheel; \
    python -m pip install -r /tmp/agent-sandbox/python-requirements.txt

COPY packages/loom-launcher /tmp/agent-sandbox/loom-launcher

RUN set -eux; \
    python -m pip install -e /tmp/agent-sandbox/loom-launcher

RUN set -eux; \
    python -c 'from pathlib import Path; from loom_launcher.adapters._aider_install import AIDER_INSTALL_SCRIPT; Path("/tmp/loom-aider-install.sh").write_text(AIDER_INSTALL_SCRIPT, encoding="utf-8")'; \
    chmod 0700 /tmp/loom-aider-install.sh; \
    LOOM_AIDER_VENV=/opt/agent-runtimes/python-cli/aider /bin/bash /tmp/loom-aider-install.sh; \
    rm -f /tmp/loom-aider-install.sh; \
    python -m venv /opt/agent-runtimes/python-cli/mini-swe-agent; \
    /opt/agent-runtimes/python-cli/mini-swe-agent/bin/python -m pip install --upgrade pip setuptools wheel; \
    /opt/agent-runtimes/python-cli/mini-swe-agent/bin/python -m pip install "$(grep ^mini-swe-agent== /tmp/agent-sandbox/python-cli-requirements.txt)"; \
    ln -sf /opt/agent-runtimes/python-cli/mini-swe-agent/bin/mini-swe-agent /usr/local/bin/mini-swe-agent

RUN set -eux; \
    command -v claude; \
    command -v codex; \
    command -v gemini; \
    command -v kimi; \
    command -v opencode; \
    command -v qwen; \
    command -v aider; \
    command -v mini-swe-agent; \
    python -c 'import importlib; importlib.import_module("openhands.sdk")'; \
    python -c 'import importlib; importlib.import_module("openhands.tools.terminal")'; \
    python -c 'import importlib; importlib.import_module("loom_launcher.openhands_sdk_runner")'; \
    command -v tmux; \
    python -c 'import importlib; importlib.import_module("sweagent.run.run_single")'

ENTRYPOINT ["tini", "--"]
CMD ["bash"]
