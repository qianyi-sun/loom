#!/bin/sh
set -eu
umask 077

case "${SUDO_USER-}" in
  ""|*[!a-zA-Z0-9_-]*)
    printf '%s\n' '{"passed":false,"assessment_complete":false,"failure_code":"preflight-authorization-rejected","stage":"authorization","diagnostic_recorded":false,"checks":[{"name":"preflight-authorization-rejected","passed":false}]}' >&2
    exit 1
    ;;
esac
case "${SUDO_UID-}:${SUDO_GID-}" in
  *[!0-9:]*|:*|*:|*:*:*)
    printf '%s\n' '{"passed":false,"assessment_complete":false,"failure_code":"preflight-authorization-rejected","stage":"authorization","diagnostic_recorded":false,"checks":[{"name":"preflight-authorization-rejected","passed":false}]}' >&2
    exit 1
    ;;
esac

service_uid=$(/usr/bin/id -u)
runtime_dir="/run/user/${service_uid}"

exec /usr/bin/env -i \
  HOME=/var/lib/loom-rollout \
  USER=loom-rollout \
  LOGNAME=loom-rollout \
  PATH=__CANDIDATE_VENV__/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
  LANG=C.UTF-8 \
  LC_ALL=C.UTF-8 \
  PYTHONDONTWRITEBYTECODE=1 \
  GIT_CONFIG_NOSYSTEM=1 \
  GIT_CONFIG_GLOBAL=/dev/null \
  GIT_TERMINAL_PROMPT=0 \
  XDG_RUNTIME_DIR="${runtime_dir}" \
  DBUS_SESSION_BUS_ADDRESS="unix:path=${runtime_dir}/bus" \
  SUDO_USER="${SUDO_USER}" \
  SUDO_UID="${SUDO_UID}" \
  SUDO_GID="${SUDO_GID}" \
  __CANDIDATE_VENV__/bin/python -I -B -m loom_cli.rollout.operator.broker "$@"
