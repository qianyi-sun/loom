#!/bin/sh
set -eu
umask 077

if [ "$(/usr/bin/id -u)" != 0 ]; then
  echo "error: credential refresh requires root" >&2
  exit 1
fi

exec /usr/bin/env -i \
  HOME=/root \
  USER=root \
  LOGNAME=root \
  PATH=__CANDIDATE_VENV__/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
  LANG=C.UTF-8 \
  LC_ALL=C.UTF-8 \
  PYTHONDONTWRITEBYTECODE=1 \
  __CANDIDATE_VENV__/bin/python -I -B -m \
  loom_cli.rollout.operator.preflight_credential_installer refresh
