FROM python:3.11-slim
# #199: transient PyPI ReadTimeouts during rollout builds — see
# docs/runbooks/operator-runbook.md#rollout-build-resilience.
ENV PIP_RETRIES=10 PIP_DEFAULT_TIMEOUT=60
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
COPY migrations ./migrations
RUN pip install --no-cache-dir -e .
EXPOSE 8080
CMD ["python", "-m", "loom_control_plane"]
