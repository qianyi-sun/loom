# Candidate-bound browser runtime for the broker-owned staging acceptance step.
# The multi-arch Playwright base is pinned by immutable manifest-list digest;
# the rollout currently builds the linux/amd64 member on platform-dev.
FROM mcr.microsoft.com/playwright:v1.61.1-noble@sha256:5b8f294aff9041b7191c34a4bab3ac270157a28774d4b0660e9743297b697e48

ARG LOOM_BUILD_SHA
LABEL org.opencontainers.image.revision="${LOOM_BUILD_SHA}"

WORKDIR /opt/loom
COPY web/package.json web/package-lock.json ./web/
RUN npm ci --prefix web --ignore-scripts \
    && npm cache clean --force
RUN install -d -o root -g root -m 0755 /opt/loom/web/scripts
COPY --chmod=0444 web/scripts/staging-admin-browser-smoke.mjs \
    /opt/loom/web/scripts/staging-admin-browser-smoke.mjs

ENTRYPOINT ["node", "/opt/loom/web/scripts/staging-admin-browser-smoke.mjs"]
