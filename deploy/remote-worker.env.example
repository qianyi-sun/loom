# Copy this file to an untracked env file on each remote worker host.
# Do not commit filled values.

# Optional image tag. Use `dev` when building from this checkout.
LOOM_IMAGE_TAG=dev

# Existing Loom control-node endpoints reachable from the worker host.
LOOM_WORKER_CONTROL_PLANE_URL=http://CONTROL_NODE:8080
LOOM_WORKER_GATEWAY_URL=http://CONTROL_NODE:9100
LOOM_WORKER_MINIO_ENDPOINT=http://CONTROL_NODE:9000

# Optional sandbox-facing Gateway facade URL for external subprocess agents.
# Leave unset when Docker sandboxes can use LOOM_WORKER_GATEWAY_URL.
# LOOM_WORKER_SUBPROCESS_GATEWAY_URL=http://host.docker.internal:30443/openai/v1

# Worker bearer token minted by the control plane admin endpoint.
LOOM_WORKER_TOKEN=replace-me

# MinIO credentials matching the control-node object store.
LOOM_WORKER_MINIO_ACCESS_KEY=replace-me
LOOM_WORKER_MINIO_SECRET_KEY=replace-me

# Per-worker process trial concurrency. Start at 5 for first contact. For
# production pools, generate a per-host plan with
# scripts/ops/worker_pool_plan.py and let the Slurm submit helper export the
# recommended value for each host.
LOOM_WORKER_MAX_CONCURRENT=5

# Per-task Dockerfile build context guardrails. Increase only when the worker
# host has enough disk, Docker, and network headroom for larger authored task
# bundles.
LOOM_TASK_IMAGE_BUILD_MAX_FILES=2000
LOOM_TASK_IMAGE_BUILD_MAX_BYTES=536870912

# Optional blocking-I/O executor threads. Leave unset to derive automatically as
# max(32, min(LOOM_WORKER_MAX_CONCURRENT * 4, 256)). Set only when capacity
# sweeps show Python blocking I/O is still the first bottleneck.
# LOOM_WORKER_BLOCKING_IO_MAX_WORKERS=128
LOOM_WORKER_LOG_LEVEL=info
