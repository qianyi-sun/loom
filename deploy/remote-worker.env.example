# Copy this file to an untracked env file on each remote worker host.
# Do not commit filled values.

# Optional image tag. Use `dev` when building from this checkout.
LOOM_IMAGE_TAG=dev

# Host-local lifecycle marker for GB10 node-agent desired-state reconciliation.
# Docker Compose reads this from the env file, but the worker container does
# not receive it because WorkerSettings rejects unknown LOOM_WORKER_* keys.
LOOM_WORKER_ENV_CONFIG_VERSION=manual-v1

# Existing Loom control-node endpoints reachable from the worker host.
LOOM_WORKER_CONTROL_PLANE_URL=http://CONTROL_NODE:8080
LOOM_WORKER_GATEWAY_URL=http://CONTROL_NODE:9100
LOOM_WORKER_MINIO_ENDPOINT=http://CONTROL_NODE:9000

# Optional sandbox-facing Gateway facade URL for external subprocess agents.
# Leave unset when Docker sandboxes can use LOOM_WORKER_GATEWAY_URL. Replace
# the port with the operator-selected sandbox bridge port when needed.
# worker_service_tunnels.py probes this as subprocess-gateway when set; install
# that port with --subprocess-gateway-local-port if it differs from the worker
# Gateway tunnel port.
# LOOM_WORKER_SUBPROCESS_GATEWAY_URL=http://host.docker.internal:30443/openai/v1

# Worker bearer token minted by the control plane admin endpoint.
LOOM_WORKER_TOKEN=replace-me

# MinIO credentials matching the control-node object store.
LOOM_WORKER_MINIO_ACCESS_KEY=replace-me
LOOM_WORKER_MINIO_SECRET_KEY=replace-me

# Worker-side SDK timeout/pool defaults for benchmark sweeps. Raise only when
# worker logs show docker-py read timeouts or S3 download/upload timeouts.
LOOM_WORKER_DOCKER_API_TIMEOUT_SEC=1800
LOOM_WORKER_MINIO_MAX_POOL_CONNECTIONS=256
LOOM_WORKER_MINIO_CONNECT_TIMEOUT_SEC=5
LOOM_WORKER_MINIO_READ_TIMEOUT_SEC=120
LOOM_WORKER_MINIO_OPERATION_TIMEOUT_SEC=300
LOOM_WORKER_MINIO_OPERATION_ATTEMPTS=3

# Optional registration hostname override. Set this to the physical/VM host
# name for remote worker pools so Monitor and worker inventory can distinguish
# nodes instead of showing the container hostname.
# LOOM_WORKER_HOSTNAME=worker-host-a

# Resource-pool label used by Monitor, `loom resources status`, and metrics.
# Set a stable shared name for hosts that should be grouped together, e.g.
# gb10-arm64, oldlab, or remote-worker.
LOOM_WORKER_POOL_NAME=remote-worker

# Per-worker process trial concurrency. Start at 5 for first contact. For
# production pools, generate a per-host plan with
# scripts/ops/worker_pool_plan.py and let the Slurm submit helper export the
# recommended value for each host.
LOOM_WORKER_MAX_CONCURRENT=5

# Optional elastic-pool lifecycle. Leave unset for fixed long-running workers.
# Slurm workers can set this so the allocation exits successfully after the
# queue drains and no trial is in flight.
# LOOM_WORKER_IDLE_EXIT_AFTER_SECONDS=600

# Per-task Dockerfile build context guardrails. Increase only when the worker
# host has enough disk, Docker, and network headroom for larger authored task
# bundles.
LOOM_TASK_IMAGE_BUILD_MAX_FILES=2000
LOOM_TASK_IMAGE_BUILD_MAX_BYTES=536870912

# Optional blocking-I/O executor threads. Leave unset to derive automatically as
# max(32, min(LOOM_WORKER_MAX_CONCURRENT * 4, 256)). Set only when capacity
# sweeps show Python blocking I/O is still the first bottleneck.
# LOOM_WORKER_BLOCKING_IO_MAX_WORKERS=128
LOOM_WORKER_LOG_LEVEL=info
