# Multi-stage build: node builds the SPA bundle; nginx serves it.
#
# Stage 1 — build
FROM node:20-slim AS build
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

# Stage 2 — serve. `nginxinc/nginx-unprivileged` is the official
# non-root nginx image: runs as uid 101 (`nginx`), listens on 8080
# (unprivileged port) by default. Avoids a root-in-container surface
# for CVEs in the nginx master process.
FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY --from=build /web/dist /usr/share/nginx/html
COPY deploy/nginx-spa.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
# nginx runs in the foreground via the base image's CMD.
