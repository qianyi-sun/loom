FROM python:3.11-slim
# Retry transient package-index timeouts during image builds.
ENV PIP_RETRIES=10 PIP_DEFAULT_TIMEOUT=60
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
COPY migrations ./migrations
RUN chmod -R a+rX ./src ./migrations && \
    pip install --no-cache-dir -e .
EXPOSE 9100
CMD ["python", "-m", "loom_llm_gateway"]
