[Unit]
Description=Loom shared-capacity handoff adapter (%i)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/loom/shared-capacity-adapters/%i.toml

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/loom-shared-capacity/candidates/${GIT_SHA}/repo
Environment=PATH=/opt/loom-shared-capacity/candidates/${GIT_SHA}/venv/bin:/usr/local/bin:/usr/bin:/bin
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/loom/shared-capacity-adapters /etc/loom/developer-sandboxes /srv/loom/developer-sandboxes
ReadWritePaths=/var/lib/loom-shared-capacity
ExecStart=/opt/loom-shared-capacity/candidates/${GIT_SHA}/venv/bin/python -I -B /opt/loom-shared-capacity/candidates/${GIT_SHA}/repo/scripts/ops/shared_capacity_adapter.py --config /etc/loom/shared-capacity-adapters/%i.toml run
TimeoutStartSec=60
