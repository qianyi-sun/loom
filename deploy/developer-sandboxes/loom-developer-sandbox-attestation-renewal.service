[Unit]
Description=Renew the complete registry-owned developer environment cohort
Requires=network-online.target loom-developer-sandbox-links.target
After=network-online.target loom-developer-sandbox-links.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 -I -B /usr/local/libexec/loom-developer-environment-deploy renew-active --execute
TimeoutStartSec=10min
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6
# Renewal uses the same fixed local runuser -> sudo node-authority route as
# remote collection; it never accepts an operator-selected command.
NoNewPrivileges=false
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/loom/developer-sandboxes/desired
ReadWritePaths=/run/loom-developer-sandbox-installer
ReadWritePaths=/var/lib/loom-developer-sandbox-installer
ReadWritePaths=/var/lib/loom-developer-sandbox-links/attestations
ReadWritePaths=/var/lib/loom-shared-capacity/runtime-attestations
ReadWritePaths=/shared_work/loom/runtime
ReadWritePaths=/srv/loom/developer-environments
