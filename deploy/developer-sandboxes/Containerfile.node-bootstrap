FROM debian@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818

ARG TARGETARCH

RUN case "$TARGETARCH" in amd64|arm64) ;; *) exit 1 ;; esac \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        git=1:2.39.5-0+deb12u3 \
        python3=3.11.2-1+b1 \
    && rm -rf /var/lib/apt/lists/*

COPY --chown=0:0 scripts/ops/developer_sandbox_node_docker_bootstrap.py \
    /usr/local/libexec/loom-developer-sandbox-node-docker-bootstrap

RUN chmod 0555 /usr/local/libexec/loom-developer-sandbox-node-docker-bootstrap

USER 0:0
ENTRYPOINT ["/usr/bin/python3", "-I", "/usr/local/libexec/loom-developer-sandbox-node-docker-bootstrap"]
