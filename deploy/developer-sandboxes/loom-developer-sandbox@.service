[Unit]
Description=Migrate legacy-v1 seed developer sandbox %i
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/etc/loom/developer-sandboxes/desired/%i.json

[Service]
Type=oneshot
UMask=0077
ExecStart=/usr/local/libexec/loom-developer-sandbox-host service-converge --legacy-v1-seed-migrate --sandbox %i
TimeoutStartSec=infinity
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6

[Install]
WantedBy=multi-user.target
