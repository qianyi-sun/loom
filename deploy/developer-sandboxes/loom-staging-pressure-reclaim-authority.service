[Unit]
Description=Verify the current staging pressure-reclaim authority receipt
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/loom/staging-shared

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/loom-staging-pressure-reclaim-authority verify-current
User=root
Group=root
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/loom-staging-pressure-reclaim /srv/loom/staging-shared/results/pressure-reclaim
ReadOnlyPaths=/etc/loom/staging-pressure-reclaim

[Install]
WantedBy=multi-user.target
