FROM python:3.12.13-slim-bookworm@sha256:4766d8b510c428e595d74b9cc5bbb2fae8e26316fffb4adc89908d79aacd58a2

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /workspace

RUN groupadd --gid 65532 loom-fixture \
    && useradd --uid 65532 --gid 65532 --no-create-home --shell /usr/sbin/nologin loom-fixture

COPY --chmod=0444 src/loom/__init__.py /usr/local/lib/python3.12/site-packages/loom/__init__.py
COPY --chmod=0444 src/loom/pipeline_fixture.py /usr/local/lib/python3.12/site-packages/loom/pipeline_fixture.py
RUN chmod 0555 /usr/local/lib/python3.12/site-packages/loom

USER 65532:65532

ENTRYPOINT ["python", "-I", "-m", "loom.pipeline_fixture"]
