FROM python:3.11-slim
# Matches the Control Plane image's package-index retry policy.
ENV PIP_RETRIES=10 PIP_DEFAULT_TIMEOUT=60
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
COPY packages/loom-bundle-checksum ./packages/loom-bundle-checksum
COPY migrations ./migrations
RUN pip install --no-cache-dir -e ./packages/loom-bundle-checksum && \
    pip install --no-cache-dir -e .
CMD ["python", "-m", "loom_family_orchestrator"]
