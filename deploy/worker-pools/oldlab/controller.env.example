# Example Control Plane env overrides for staged OLDLAB elastic capacity.
# Keep real remote-worker env files and worker tokens outside git.
# ENV_FILE and REPO_DIR must be readable from every included Slurm node. For
# OLDLAB public-beta capacity use shared paths, for example:
#   ENV_FILE=/shared_work/<operator>/loom-worker-capacity/<env>.env
#   REPO_DIR=/shared_work/<operator>/loom-remote-worker
LOOM_CP_SLURM_WORKER_CONTROLLER_ENABLED=true
LOOM_CP_SLURM_WORKER_CONTROLLER_ENVIRONMENT=production
LOOM_CP_SLURM_WORKER_CONTROLLER_POOL_NAME=oldlab
LOOM_CP_SLURM_WORKER_CONTROLLER_ALLOWED_NODES=TRT-EAI-OLDLAB-1,trt-EAI-OLDLAB-2,trt-eai-oldlab-3,trt-eai-oldlab-4,trt-eai-oldlab-5
LOOM_CP_SLURM_WORKER_CONTROLLER_ENV_FILE=/secure/path/.env.remote-worker
LOOM_CP_SLURM_WORKER_CONTROLLER_REPO_DIR=/shared_work/<operator>/loom-remote-worker
LOOM_CP_SLURM_WORKER_CONTROLLER_REQUESTED_CPUS=12
LOOM_CP_SLURM_WORKER_CONTROLLER_REQUESTED_MEMORY_MIB=58000
LOOM_CP_SLURM_WORKER_CONTROLLER_REQUESTED_CONCURRENCY=6
LOOM_CP_SLURM_WORKER_CONTROLLER_MAX_JOBS=5
LOOM_CP_SLURM_WORKER_CONTROLLER_PENDING_JOB_CAP=2
LOOM_CP_SLURM_WORKER_CONTROLLER_TIME_LIMIT=7-00:00:00
LOOM_CP_SLURM_WORKER_CONTROLLER_MIN_QUEUED_TRIALS=1
LOOM_CP_SLURM_WORKER_CONTROLLER_STALE_AFTER_SECONDS=300
