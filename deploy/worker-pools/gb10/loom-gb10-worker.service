[Unit]
Description=Loom GB10 remote worker compose service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/qianyi/loom-worker-build-staging
ExecStart=/usr/bin/env docker compose --env-file /home/qianyi/loom-worker-build-staging/.env -f deploy/docker-compose.remote-worker.yml -f deploy/worker-pools/gb10/docker-compose.gb10-hostnet.yml up -d --build
ExecStop=/usr/bin/env docker compose --env-file /home/qianyi/loom-worker-build-staging/.env -f deploy/docker-compose.remote-worker.yml -f deploy/worker-pools/gb10/docker-compose.gb10-hostnet.yml down
RemainAfterExit=yes
TimeoutStartSec=0

[Install]
WantedBy=default.target
