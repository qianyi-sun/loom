FROM python:3.11-slim
# #199: transient PyPI ReadTimeouts during staging rollout builds
# used to fail the whole rollout. These env vars tell pip to retry each
# request 10 times and wait 60s per attempt instead of the 5-retry /
# 15s defaults. See docs/operator-runbook.md#kind-cluster-loading-local-images
# and the "Rollout build resilience" runbook section for the retry policy.
ENV PIP_RETRIES=10 PIP_DEFAULT_TIMEOUT=60
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
COPY packages ./packages
COPY migrations ./migrations
RUN pip install --no-cache-dir -e . && \
    pip install --no-cache-dir -e ./packages/loom-launcher
EXPOSE 8090
CMD ["python", "-m", "loom_service"]
