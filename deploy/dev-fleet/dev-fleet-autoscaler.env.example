# Non-secret supervisor configuration. Database credentials live in the two
# owner-only files referenced below, never in this EnvironmentFile.
LOOM_DEV_MANAGEMENT_DB_URL_FILE=/etc/loom/secrets/dev-management-db-url
LOOM_DEV_FIXTURE_ADMIN_DB_URL_FILE=/etc/loom/secrets/dev-fixture-admin-db-url
LOOM_DEV_STATE_DB=/var/lib/loom-dev-autoscaler/ledger.sqlite3
LOOM_DEV_GRANT_REPORT=/var/lib/loom-dev-autoscaler/grants.json
LOOM_DEV_GLOBAL_BUDGET=8
LOOM_DEV_GLOBAL_PENDING_BUDGET=4
LOOM_DEV_WORKER_ENV_DIR=/var/lib/loom-dev-workers
LOOM_DEV_WORKER_MINIO_ENDPOINT=https://minio.dev.yylx.world
LOOM_DEV_IMAGE_TAG=dev-0123456
LOOM_DEV_KUBECTL=/usr/local/bin/kubectl
LOOM_DEV_KUBE_CONTEXT=loom-fleet
