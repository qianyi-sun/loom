[Unit]
Description=Loom global development fleet autoscaler
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=loom-dev-autoscaler
Group=loom-dev-autoscaler
EnvironmentFile=/etc/loom/dev-fleet-autoscaler.env
UMask=0077
ExecStart=/opt/loom-dev-autoscaler/venv/bin/python /opt/loom-dev-autoscaler/repo/scripts/ops/global_dev_fleet_autoscaler_external_once.py --management-db-url-file ${LOOM_DEV_MANAGEMENT_DB_URL_FILE} --fixture-admin-db-url-file ${LOOM_DEV_FIXTURE_ADMIN_DB_URL_FILE} --state-db ${LOOM_DEV_STATE_DB} --output-json ${LOOM_DEV_GRANT_REPORT} --global-budget ${LOOM_DEV_GLOBAL_BUDGET} --global-pending-budget ${LOOM_DEV_GLOBAL_PENDING_BUDGET} --worker-env-dir ${LOOM_DEV_WORKER_ENV_DIR} --worker-minio-endpoint ${LOOM_DEV_WORKER_MINIO_ENDPOINT} --image-tag ${LOOM_DEV_IMAGE_TAG} --kubectl ${LOOM_DEV_KUBECTL} --kube-context ${LOOM_DEV_KUBE_CONTEXT}
NoNewPrivileges=true
PrivateTmp=true
ProtectClock=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/loom-dev-autoscaler /var/lib/loom-dev-workers
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
