[Unit]
Description=Reconcile Loom staging credentials and PostgreSQL CA to Nebius
After=network-online.target wg-quick@wg-loom-nb.service
Wants=network-online.target
Requires=wg-quick@wg-loom-nb.service

[Service]
Type=oneshot
User=root
UMask=0077
Environment=PYTHONPATH=/opt/loom-nebius-staging-credentials/source/src
Environment=PATH=/opt/loom-nebius-staging-credentials/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/loom-nebius-staging-credentials/.venv/bin/python /opt/loom-nebius-staging-credentials/source/scripts/ops/nebius_staging_credentials.py reconcile --config /etc/loom/nebius-staging-credentials.json
TimeoutStartSec=180

