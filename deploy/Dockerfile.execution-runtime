FROM golang:1.25.7-alpine@sha256:f6751d823c26342f9506c03797d2527668d095b0a15f1862cddb4d927a7a4ced AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/loom-execution-runtime ./cmd/loom-execution-runtime
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" \
    -o /out/loom-execution-runtime ./cmd/loom-execution-runtime

FROM scratch
COPY --from=build /out/loom-execution-runtime /loom-execution-runtime
USER 65532:65532
ENTRYPOINT ["/loom-execution-runtime"]
