+func (m *Mount) mountWithDirectFUSE(helperBinary, target string) error {
+	if !filepath.IsAbs(helperBinary) || filepath.Clean(helperBinary) != helperBinary {
+		return fmt.Errorf("direct FUSE helper path %q is not absolute and clean", helperBinary)
+	}
+	args := []string{}
+	for _, o := range m.Options {
