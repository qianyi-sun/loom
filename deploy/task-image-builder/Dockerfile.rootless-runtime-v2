FROM moby/buildkit:rootless@sha256:504731e577c20559c00f968f33219f30115e70be29ab96728d1d06e963fc494b AS upstream-runtime

FROM upstream-runtime AS verified-runtime
ARG TARGETARCH
USER root
RUN mkdir -p /out /runtime
COPY --from=patched-runtime --chown=0:0 --chmod=0555 /out/buildctl /out/buildctl
COPY --from=patched-runtime --chown=0:0 --chmod=0555 /out/buildkitd /out/buildkitd
COPY --from=patched-runtime --chown=0:0 --chmod=0555 /out/rootlesskit /out/rootlesskit
COPY --from=patched-runtime --chown=0:0 --chmod=0555 /out/rootlessctl /out/rootlessctl
COPY --from=patched-runtime --chown=0:0 --chmod=0555 /downloads /downloads
RUN cp /usr/bin/buildkit-runc /out/buildkit-runc \
    && case "$TARGETARCH" in \
        amd64) cp /downloads/slirp4netns-x86_64 /out/slirp4netns; cp /downloads/fuse-overlayfs-x86_64 /out/fuse-overlayfs ;; \
        arm64) cp /downloads/slirp4netns-aarch64 /out/slirp4netns; cp /downloads/fuse-overlayfs-aarch64 /out/fuse-overlayfs ;; \
        *) exit 1 ;; \
    esac \
    && chmod 0555 /out/buildkit-runc /out/slirp4netns /out/fuse-overlayfs \
    && cp /out/buildctl /runtime/buildctl \
    && cp /out/buildkitd /runtime/buildkitd \
    && cp /out/buildkit-runc /runtime/buildkit-runc \
    && cp /out/rootlesskit /runtime/rootlesskit \
    && cp /out/rootlessctl /runtime/rootlessctl \
    && cp /out/slirp4netns /runtime/slirp4netns \
    && cp /out/fuse-overlayfs /runtime/fuse-overlayfs \
    && test "$(/runtime/buildctl --version)" = "buildctl github.com/moby/buildkit v0.32.2-loom.1 991535e0973488b6a429096d21fa13f81f2d89d8" \
