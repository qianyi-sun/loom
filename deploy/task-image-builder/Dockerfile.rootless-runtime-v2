        *) exit 1 ;; \
    esac \
    && printf '%s  %s\n' \
        "$buildctl_sha256" /runtime/buildctl \
        "$buildkitd_sha256" /runtime/buildkitd \
        "$buildkit_runc_sha256" /runtime/buildkit-runc \
