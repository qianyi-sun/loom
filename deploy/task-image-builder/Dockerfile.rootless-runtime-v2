    && test "$(/runtime/rootlesskit --version)" = "rootlesskit version 3.1.0" \
    && case "$TARGETARCH" in \
        amd64) buildctl_sha256=b2dc3eb537b912717670347cf449ca501e769d5a6beeebaad0aab8abb7f495e1; buildkitd_sha256=0e01e2cac7df591ac129ee86543ac36bc6ef08b50aee8550f5675675208564e7; buildkit_runc_sha256=b886d74fee2529334f7dcdd75a0a7a9e4935efb5554f96d2cdd26a564aa91c8c; rootlesskit_sha256=b607adb41b2537c3b6335e0ecdd4a269d9531c9258ec9261ff36220c820801db; rootlessctl_sha256=5f04200c8a5167f73b04b790fe59ebfb7fbffb505521002ef8bdaf254e220a96; slirp4netns_sha256=e8d0440de8d8c87072138883bc27cfa02f8b0e8a504badbf335c41f794788cc2; fuse_overlayfs_sha256=1684ef18c337702a0378a4e9942802770c83b11aed6a93c445d43e641a1f3c90 ;; \
