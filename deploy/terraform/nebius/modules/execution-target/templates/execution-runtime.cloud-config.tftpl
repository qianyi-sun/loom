#cloud-config
write_files:
  - path: /usr/local/sbin/install-loom-nebius-runtime
    owner: root:root
    permissions: '0500'
    content: |
      #!/bin/bash
      set -euo pipefail
      exec >/dev/ttyS0 2>&1
      release_root='${release_root}'
      runsc_config='${runsc_config}'
      containerd_drop_in='${containerd_drop_in}'
      shim_link='${shim_link}'
      stage=''
      archive=''
      committed=0
      cleanup() {
        if [[ -n "$archive" ]]; then rm -f "$archive"; fi
        if [[ "$stage" == /opt/loom/gvisor/.loom-stage.* ]]; then rm -rf "$stage"; fi
        if [[ "$committed" != 1 ]]; then
          rm -f "$containerd_drop_in" "$runsc_config" "$shim_link"
          systemctl restart containerd || true
          echo 'LOOM_NEBIUS_RUNTIME_INSTALL_FAILED'
        fi
      }
      trap cleanup EXIT
      echo 'LOOM_NEBIUS_RUNTIME_INSTALL_BEGIN'
      install -d -o root -g root -m 0755 /opt/loom/gvisor /etc/containerd/conf.d
      stage="$(mktemp -d /opt/loom/gvisor/.loom-stage.XXXXXX)"
      archive="$(mktemp /var/tmp/loom-gvisor.XXXXXX.tar.bz2)"
      [[ "$(uname -m)" == x86_64 ]]
      containerd --version | grep -F ' ${containerd_version} '
      grep -F 'imports = ["${import_glob}"]' /etc/containerd/config.toml
      [[ "$(cat /proc/sys/kernel/unprivileged_userns_clone)" == 1 ]]
      [[ ! -e /dev/kvm ]]
      curl --fail --location --proto '=https' --tlsv1.2 --retry 5 --retry-delay 2 \
        --output "$archive" '${archive_url}'
      printf '%s  %s\n' '${archive_sha512}' "$archive" | sha512sum --check --strict -
      python3 - "$archive" "$stage" <<'PYTHON'
      import pathlib
      import sys
      import tarfile

      archive = pathlib.Path(sys.argv[1])
      destination = pathlib.Path(sys.argv[2])
      expected_files = {
          "containerd-shim-runsc-v1",
          "gvisor-bin/checkpointgofer",
          "gvisor-bin/gvisor_sentry",
          "gvisor-bin/runsc-metric-server",
          "runsc",
      }
      with tarfile.open(archive, "r:bz2") as bundle:
          members = bundle.getmembers()
          regular_files = {member.name for member in members if member.isfile()}
          if regular_files != expected_files:
              raise SystemExit("archive_regular_files_invalid")
          if any(member.issym() or member.islnk() or member.isdev() for member in members):
              raise SystemExit("archive_special_member_invalid")
          bundle.extractall(destination, filter="data")
      PYTHON
      [[ "$(stat -c %s "$stage/runsc")" == '${runsc_size}' ]]
      [[ "$(sha256sum "$stage/runsc" | cut -d ' ' -f 1)" == '${runsc_sha256}' ]]
      [[ "$(stat -c %s "$stage/containerd-shim-runsc-v1")" == '${shim_size}' ]]
      [[ "$(sha256sum "$stage/containerd-shim-runsc-v1" | cut -d ' ' -f 1)" == '${shim_sha256}' ]]
      install -d -o root -g root -m 0555 "$release_root"
      install -o root -g root -m 0555 "$stage/runsc" "$release_root/runsc"
      install -o root -g root -m 0555 "$stage/containerd-shim-runsc-v1" "$release_root/containerd-shim-runsc-v1"
      ln -sfn "$release_root/containerd-shim-runsc-v1" "$shim_link"
      install -o root -g root -m 0444 /dev/stdin "$runsc_config" <<'RUNSC'
      binary_name = "${release_root}/runsc"

      [runsc_config]
        allow-flag-override = "false"
        allow-packet-socket-write = "false"
        allow-suid = "false"
        debug = "false"
        directfs = "false"
        file-access = "exclusive"
        gvisor-marker-file = "true"
        host-fifo = "none"
        host-settings = "check"
        host-uds = "none"
        net-raw = "false"
        network = "sandbox"
        oci-seccomp = "true"
        platform = "systrap"
        profile = "false"
        restore-spec-validation = "enforce"
        sidecar-release-enforcement-policy = "ALWAYS"
        strace = "false"
        watchdog-action = "panic"
      RUNSC
      install -o root -g root -m 0444 /dev/stdin "$containerd_drop_in" <<'CONTAINERD'
      version = 3

      [plugins.'io.containerd.cri.v1.runtime'.containerd.runtimes.'runsc-loom-sandbox']
        runtime_type = "io.containerd.runsc.v1"
      [plugins.'io.containerd.cri.v1.runtime'.containerd.runtimes.'runsc-loom-sandbox'.options]
        TypeUrl = "io.containerd.runsc.v1.options"
        ConfigPath = "/etc/containerd/runsc-loom-sandbox.toml"
      CONTAINERD
      containerd config dump | grep -F 'runsc-loom-sandbox'
      systemctl restart containerd
      systemctl is-active --quiet containerd
      "$release_root/runsc" --version | grep -F '${release_version}'
      committed=1
      echo 'LOOM_NEBIUS_RUNTIME_INSTALL_OK profile_sha256=${profile_sha256}'
runcmd:
  - [timeout, 10m, /usr/local/sbin/install-loom-nebius-runtime]
