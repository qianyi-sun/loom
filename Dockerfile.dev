FROM python:3.12-slim

ARG DOCKER_CLI_VERSION=29.1.3
ARG DOCKER_CLI_SHA256_X86_64=c019c608ba2bb009dd673f3230e4d743f36a78d36166c6c2444c05d0aa9ff0d9
ARG DOCKER_CLI_SHA256_AARCH64=2219f3ac48727d8c5546b13d5d271a58856188ecb8ff1f71f9e2f9aefde3ea76
ARG DOCKER_COMPOSE_VERSION=2.40.3
ARG DOCKER_COMPOSE_SHA256_X86_64=dba9d98e1ba5bfe11d88c99b9bd32fc4a0624a30fafe68eea34d61a3e42fd372
ARG DOCKER_COMPOSE_SHA256_AARCH64=d26373b19e89160546d15407516cc59f453030d9bc5b43ba7faf16f7b4980137
ARG HARBOR_VERSION=0.9.0

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1

WORKDIR /workspace

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git tar \
    && docker_arch="$(dpkg --print-architecture)" \
    && case "$docker_arch" in \
        amd64) docker_arch="x86_64"; docker_cli_sha256="$DOCKER_CLI_SHA256_X86_64"; docker_compose_sha256="$DOCKER_COMPOSE_SHA256_X86_64" ;; \
        arm64) docker_arch="aarch64"; docker_cli_sha256="$DOCKER_CLI_SHA256_AARCH64"; docker_compose_sha256="$DOCKER_COMPOSE_SHA256_AARCH64" ;; \
        *) echo "Unsupported Docker CLI architecture: $docker_arch" >&2; exit 1 ;; \
    esac \
    && curl -fsSL "https://download.docker.com/linux/static/stable/${docker_arch}/docker-${DOCKER_CLI_VERSION}.tgz" \
        -o /tmp/docker-cli.tgz \
    && echo "${docker_cli_sha256}  /tmp/docker-cli.tgz" | sha256sum -c - \
    && tar -xzf /tmp/docker-cli.tgz -C /usr/local/bin --strip-components=1 docker/docker \
    && chmod +x /usr/local/bin/docker \
    && install -d /usr/local/lib/docker/cli-plugins \
    && curl -fsSL "https://github.com/docker/compose/releases/download/v${DOCKER_COMPOSE_VERSION}/docker-compose-linux-${docker_arch}" \
        -o /usr/local/lib/docker/cli-plugins/docker-compose \
    && echo "${docker_compose_sha256}  /usr/local/lib/docker/cli-plugins/docker-compose" | sha256sum -c - \
    && chmod +x /usr/local/lib/docker/cli-plugins/docker-compose \
    && docker --version \
    && docker compose version \
    && rm -f /tmp/docker-cli.tgz \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md VERSION ./
COPY src ./src
COPY tests ./tests

RUN python -m pip install --upgrade pip \
    && python -m pip install "harbor==${HARBOR_VERSION}" \
    && harbor --version \
    && harbor run --help >/dev/null \
    && python -m pip install -e .

CMD ["python", "-m", "unittest", "discover", "-s", "tests", "-v"]
