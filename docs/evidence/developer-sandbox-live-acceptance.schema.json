        },
        "write_bytes": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "write_limit_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5497558138880
        },
        "io_errors": {
          "const": 0
        },
        "enospc_events": {
          "const": 0
        }
      }
