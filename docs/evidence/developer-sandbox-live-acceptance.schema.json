            "ttl_expiry",
            "submit_host_restart",
            "worker_crash"
          ]
        },
        "phase": {
          "enum": [
            "cancel_cleanup",
            "ttl_cleanup",
            "submit_host_restart",
            "worker_crash"
          ]
        },
        "candidate_sha": {
          "$ref": "#/$defs/fullSha"
        },
        "candidate_tree": {
          "$ref": "#/$defs/fullSha"
        },
        "sandbox": {
          "$ref": "#/$defs/sandbox"
        },
        "pool": {
          "$ref": "#/$defs/pool"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "injected_at": {
          "$ref": "#/$defs/timestamp"
        },
        "recovered_at": {
          "$ref": "#/$defs/timestamp"
        },
        "recovery_deadline_seconds": {
          "const": 600
        },
        "orphan_jobs": {
          "const": 0
        },
        "orphan_containers": {
          "const": 0
        },
        "orphan_leases": {
          "const": 0
        },
        "orphan_trials": {
          "const": 0
        },
        "retry_attribution": {
          "$ref": "#/$defs/retryAttribution"
        }
      }
    },
    "cgroupPath": {
      "type": "string",
      "pattern": "^/(?:[A-Za-z0-9_.:@-]+/?)+$",
      "minLength": 2,
      "maxLength": 1024
    }
  }
}
