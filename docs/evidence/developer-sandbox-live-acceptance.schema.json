{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loom.example/schemas/developer-sandbox-live-acceptance-v2.json",
  "title": "Multi-candidate developer sandbox live acceptance evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidates",
    "promotion_candidate",
    "session",
    "topology",
    "state_machine",
    "overlap_windows",
    "cross_sandbox_negative",
    "capacity_samples",
    "large_batch_bursts",
    "fairness",
    "runtime_envelopes",
    "peer_workloads",
    "storage_io",
    "fault_recovery",
    "staging_pressure_reclaim",
    "platform_health",
    "invariants"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "candidates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qianyi",
        "hongjian",
        "devansh"
      ],
      "properties": {
        "qianyi": {
          "$ref": "#/$defs/sandboxCandidate"
        },
        "hongjian": {
          "$ref": "#/$defs/sandboxCandidate"
        },
        "devansh": {
          "$ref": "#/$defs/sandboxCandidate"
        }
      }
    },
    "promotion_candidate": {
      "$ref": "#/$defs/promotionCandidate"
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "submit_host",
        "execute_acknowledged",
        "started_at",
        "completed_at",
        "collected_at",
        "max_collection_lag_seconds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "submit_host": {
          "const": "trt-eai-oldlab-2"
        },
        "execute_acknowledged": {
          "const": true
        },
        "started_at": {
          "$ref": "#/$defs/timestamp"
        },
        "completed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "collected_at": {
          "$ref": "#/$defs/timestamp"
        },
        "max_collection_lag_seconds": {
          "const": 300
        }
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sandboxes",
        "pools",
        "eligible_nodes",
        "excluded_nodes",
        "slot_budgets",
        "pending_slot_budgets"
      ],
      "properties": {
        "sandboxes": {
          "const": [
            "qianyi",
            "hongjian",
            "devansh"
          ]
        },
        "pools": {
          "const": [
            "oldlab",
            "gb10"
          ]
        },
        "eligible_nodes": {
          "const": [
            "trt-eai-oldlab-1",
            "trt-eai-oldlab-2",
            "trt-eai-oldlab-3",
            "trt-eai-oldlab-4",
            "trt-eai-oldlab-5",
            "trt-gb10-1",
            "trt-gb10-2",
            "trt-gb10-3",
            "trt-gb10-4",
            "trt-gb10-5",
            "trt-gb10-6",
            "trt-gb10-8",
            "trt-gb10-9",
            "trt-gb10-10",
            "trt-gb10-11",
            "trt-gb10-12",
            "trt-gb10-13",
            "trt-gb10-14",
            "trt-gb10-15"
          ]
        },
        "excluded_nodes": {
          "const": [
            "trt-gb10-7"
          ]
        },
        "slot_budgets": {
          "const": {
            "oldlab": 20,
            "gb10": 112
          }
        },
        "pending_slot_budgets": {
          "const": {
            "oldlab": 10,
            "gb10": 24
          }
        }
      }
    },
    "state_machine": {
      "type": "array",
      "minItems": 33,
      "maxItems": 33,
      "items": {
        "$ref": "#/$defs/phase"
      }
    },
    "overlap_windows": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/overlapWindow"
      }
    },
    "cross_sandbox_negative": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": {
        "$ref": "#/$defs/crossSandboxNegative"
      }
    },
    "capacity_samples": {
      "type": "array",
      "minItems": 54,
      "maxItems": 54,
      "items": {
        "$ref": "#/$defs/capacitySample"
      }
    },
    "large_batch_bursts": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/burst"
      }
    },
    "fairness": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/fairnessWindow"
      }
    },
    "runtime_envelopes": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/runtimeEnvelope"
      }
    },
    "peer_workloads": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/peerWorkload"
      }
    },
    "storage_io": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/storageIo"
      }
    },
    "fault_recovery": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/faultRecovery"
      }
    },
    "staging_pressure_reclaim": {
      "$ref": "#/$defs/stagingPressureReclaim"
    },
    "platform_health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_evidence",
        "trusted_receipt"
      ],
      "properties": {
        "authority_evidence": {
          "type": "object",
          "required": [
            "schema_version",
            "kind",
            "session_id",
            "candidates",
            "collector_host",
            "checkpoints",
            "mixed_jobs",
            "cancelled_jobs",
            "crashed_jobs",
            "node_intervals",
            "policy_capacity",
            "zero_orphans",
            "completed_at",
            "payload_sha256"
          ]
        },
        "trusted_receipt": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "receipt_sha256",
            "authority_payload_sha256",
            "source_host",
            "observed_at"
          ],
          "properties": {
            "receipt_sha256": {
              "$ref": "#/$defs/digest"
            },
            "authority_payload_sha256": {
              "$ref": "#/$defs/digest"
            },
            "source_host": {
              "const": "trt-eai-oldlab-2"
            },
            "observed_at": {
              "$ref": "#/$defs/timestamp"
            }
          }
        }
      }
    },
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capacity_overshoot_events",
        "duplicate_observations",
        "duplicate_trials",
        "indefinite_starvation_events",
        "exclusive_slurm_jobs",
        "cgroup_escape_events",
        "peer_disruption_events",
        "storage_error_events",
        "orphan_jobs",
        "orphan_containers",
        "orphan_leases",
        "orphan_trials",
        "duplicate_retries",
        "unattributed_retries"
      ],
      "properties": {
        "capacity_overshoot_events": {
          "const": 0
        },
        "duplicate_observations": {
          "const": 0
        },
        "duplicate_trials": {
          "const": 0
        },
        "indefinite_starvation_events": {
          "const": 0
        },
        "exclusive_slurm_jobs": {
          "const": 0
        },
        "cgroup_escape_events": {
          "const": 0
        },
        "peer_disruption_events": {
          "const": 0
        },
        "storage_error_events": {
          "const": 0
        },
        "orphan_jobs": {
          "const": 0
        },
        "orphan_containers": {
          "const": 0
        },
        "orphan_leases": {
          "const": 0
        },
        "orphan_trials": {
          "const": 0
        },
        "duplicate_retries": {
          "const": 0
        },
        "unattributed_retries": {
          "const": 0
        }
      }
    }
  },
  "$defs": {
    "fullSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "nonnegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "positiveNumber": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "sandbox": {
      "enum": [
        "qianyi",
        "hongjian",
        "devansh"
      ]
    },
    "sandboxCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha",
        "tree",
        "runtime_receipts"
      ],
      "properties": {
        "sha": {
          "$ref": "#/$defs/fullSha"
        },
        "tree": {
          "$ref": "#/$defs/fullSha"
        },
        "runtime_receipts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/runtimeReceipt"
          }
        }
      }
    },
    "promotionCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha",
        "tree",
        "staging_regression",
        "trusted_receipt"
      ],
      "properties": {
        "sha": {
          "$ref": "#/$defs/fullSha"
        },
        "tree": {
          "$ref": "#/$defs/fullSha"
        },
        "staging_regression": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "phase",
            "candidate_sha",
            "candidate_tree",
            "started_at",
            "finished_at",
            "status",
            "checkpoint_sha256"
          ],
          "properties": {
            "phase": {
              "const": "promotion_staging_regression"
            },
            "candidate_sha": {
              "$ref": "#/$defs/fullSha"
            },
            "candidate_tree": {
              "$ref": "#/$defs/fullSha"
            },
            "started_at": {
              "$ref": "#/$defs/timestamp"
            },
            "finished_at": {
              "$ref": "#/$defs/timestamp"
            },
            "status": {
              "const": "pass"
            },
            "checkpoint_sha256": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        "trusted_receipt": {
          "$ref": "#/$defs/promotionReceiptReference"
        }
      }
    },
    "overlapReceiptReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "receipt_sha256"
      ],
      "properties": {
        "sequence": {
          "$ref": "#/$defs/positiveInteger"
        },
        "receipt_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "promotionReceiptReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_sha256",
        "source_host",
        "rollout_id",
        "result",
        "observed_at"
      ],
      "properties": {
        "receipt_sha256": {
          "$ref": "#/$defs/digest"
        },
        "source_host": {
          "const": "trt-eai-oldlab-1"
        },
        "rollout_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "result": {
          "const": "pass"
        },
        "observed_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "stagingPressureReclaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_evidence",
        "trusted_receipt"
      ],
      "properties": {
        "authority_evidence": {
          "$ref": "#/$defs/stagingPressureAuthorityReceipt"
        },
        "trusted_receipt": {
          "$ref": "#/$defs/stagingPressureReceiptReference"
        }
      }
    },
    "stagingPressureAuthorityReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "environment",
        "pool",
        "partition",
        "source_host",
        "submit_host",
        "sequence",
        "session_id",
        "acceptance_session_id",
        "session_sha256",
        "candidate_sha",
        "candidate_tree",
        "issued_at",
        "evidence"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "loom.staging-pressure-reclaim.receipt"
        },
        "environment": {
          "const": "staging"
        },
        "pool": {
          "const": "gb10"
        },
        "partition": {
          "const": "gb10"
        },
        "source_host": {
          "const": "trt-eai-oldlab-1"
        },
        "submit_host": {
          "const": "trt-gb10-1"
        },
        "sequence": {
          "$ref": "#/$defs/positiveInteger"
        },
        "session_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "acceptance_session_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "session_sha256": {
          "$ref": "#/$defs/digest"
        },
        "candidate_sha": {
          "$ref": "#/$defs/fullSha"
        },
        "candidate_tree": {
          "$ref": "#/$defs/fullSha"
        },
        "issued_at": {
          "$ref": "#/$defs/timestamp"
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "registry_before",
            "interrupted_trial_before",
            "claim_probe_before",
            "slurm_before",
            "foreign_peer_snapshot",
            "pressure_on",
            "claim_fence",
            "registry_terminal",
            "interrupted_trial_retryable",
            "slurm_during",
            "pressure_off",
            "claim_recovered",
            "claim_probe_requeued",
            "slurm_after",
            "foreign_peer_zero_impact"
          ],
          "properties": {
            "registry_before": {
              "type": "array",
              "minItems": 1
            },
            "interrupted_trial_before": {
              "type": "object"
            },
            "claim_probe_before": {
              "type": "object"
            },
            "slurm_before": {
              "type": "object"
            },
            "foreign_peer_snapshot": {
              "type": "array"
            },
            "pressure_on": {
              "type": "object"
            },
            "claim_fence": {
              "type": "object"
            },
            "registry_terminal": {
              "type": "array",
              "minItems": 1
            },
            "interrupted_trial_retryable": {
              "type": "object"
            },
            "slurm_during": {
              "type": "object"
            },
            "pressure_off": {
              "type": "object"
            },
            "claim_recovered": {
              "type": "object"
            },
            "claim_probe_requeued": {
              "type": "object"
            },
            "slurm_after": {
              "type": "object"
            },
            "foreign_peer_zero_impact": {
              "const": true
            }
          }
        }
      }
    },
    "stagingPressureReceiptReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_sha256",
        "authority_session_id",
        "authority_receipt_sha256",
        "authority_signature_sha256",
        "authority_key_id",
        "sequence",
        "source_host",
        "observed_at"
      ],
      "properties": {
        "receipt_sha256": {
          "$ref": "#/$defs/digest"
        },
        "authority_session_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "authority_receipt_sha256": {
          "$ref": "#/$defs/digest"
        },
        "authority_signature_sha256": {
          "$ref": "#/$defs/digest"
        },
        "authority_key_id": {
          "$ref": "#/$defs/digest"
        },
        "sequence": {
          "$ref": "#/$defs/positiveInteger"
        },
        "source_host": {
          "const": "trt-eai-oldlab-1"
        },
        "observed_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "pool": {
      "enum": [
        "oldlab",
        "gb10"
      ]
    },
    "phaseName": {
      "enum": [
        "preflight",
        "baseline",
        "multi_candidate_overlap",
        "large_batch_burst",
        "fairness_contention",
        "mixed_non_loom",
        "cancel_cleanup",
        "ttl_cleanup",
        "submit_host_restart",
        "worker_crash",
        "final_drain"
      ]
    },
    "node": {
      "type": "string",
      "pattern": "^trt-(?:eai-oldlab-[1-5]|gb10-(?:[1-6]|8|9|1[0-5]))$"
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "sandbox",
        "candidate_sha",
        "candidate_tree",
        "started_at",
        "finished_at",
        "deadline_seconds",
        "status",
        "checkpoint_sha256"
      ],
      "properties": {
        "phase": {
          "$ref": "#/$defs/phaseName"
        },
        "sandbox": {
          "$ref": "#/$defs/sandbox"
        },
        "candidate_sha": {
          "$ref": "#/$defs/fullSha"
        },
        "candidate_tree": {
          "$ref": "#/$defs/fullSha"
        },
        "started_at": {
          "$ref": "#/$defs/timestamp"
        },
        "finished_at": {
          "$ref": "#/$defs/timestamp"
        },
        "deadline_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7200
        },
        "status": {
          "const": "pass"
        },
        "checkpoint_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "jobAllocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu_cores",
        "memory_bytes",
        "pids",
        "gpu_count",
        "tres",
        "exclusive"
      ],
      "properties": {
        "cpu_cores": {
          "$ref": "#/$defs/positiveNumber"
        },
        "memory_bytes": {
          "$ref": "#/$defs/positiveInteger"
        },
        "pids": {
          "$ref": "#/$defs/positiveInteger"
        },
        "gpu_count": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "tres": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "exclusive": {
          "const": false
        }
      }
    },
    "jobReadback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sandbox",
        "pool",
        "candidate_sha",
        "candidate_tree",
        "job_id",
        "account",
        "user",
        "job_name",
        "node",
        "state",
        "allocation",
        "observed_at"
      ],
      "properties": {
        "sandbox": {
          "$ref": "#/$defs/sandbox"
        },
        "pool": {
          "$ref": "#/$defs/pool"
        },
        "candidate_sha": {
          "$ref": "#/$defs/fullSha"
        },
        "candidate_tree": {
          "$ref": "#/$defs/fullSha"
        },
        "job_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(?:_[0-9]+)?$"
        },
        "account": {
          "type": "string",
          "pattern": "^loom-dev-(?:qianyi|hongjian|devansh)$"
        },
        "user": {
          "type": "string",
          "pattern": "^loom-sandbox-(?:qianyi|hongjian|devansh)$"
        },
        "job_name": {
          "type": "string",
          "pattern": "^loom-sandbox-(?:qianyi|hongjian|devansh)-[0-9a-f]{12}-[A-Za-z0-9_.-]+$",
          "maxLength": 128
        },
        "node": {
          "$ref": "#/$defs/node"
        },
        "state": {
          "const": "RUNNING"
        },
        "allocation": {
          "$ref": "#/$defs/jobAllocation"
        },
        "observed_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "serviceReadback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sandbox",
        "candidate_sha",
        "candidate_tree",
        "unit",
        "active_state",
        "sub_state",
        "observed_at"
      ],
      "properties": {
        "sandbox": {
          "$ref": "#/$defs/sandbox"
        },
        "candidate_sha": {
          "$ref": "#/$defs/fullSha"
        },
        "candidate_tree": {
          "$ref": "#/$defs/fullSha"
        },
        "unit": {
          "type": "string",
          "pattern": "^loom-developer-sandbox-(?:qianyi|hongjian|devansh)\\.service$"
        },
        "active_state": {
          "const": "active"
        },
        "sub_state": {
          "const": "running"
        },
        "observed_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "capacityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "lease_epoch",
        "observation_sequence",
        "sample_sha256"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "lease_epoch": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "observation_sequence": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "sample_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "overlapWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "pool",
        "started_at",
        "finished_at",
        "observations"
      ],
