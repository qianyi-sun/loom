          "type": "string",
          "pattern": "^[1-9][0-9]*(?:_[0-9]+)?$"
        },
        "account": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "not": {
            "pattern": "^loom-dev(?:-|$)"
          }
        },
        "baseline": {
          "$ref": "#/$defs/peerCheckpoint"
        },
        "during": {
          "$ref": "#/$defs/peerCheckpoint"
        },
        "after": {
          "$ref": "#/$defs/peerCheckpoint"
        },
        "max_throughput_regression_ratio": {
          "const": 0.2
        },
        "disrupted": {
          "const": false
        }
      }
    },
    "storageIo": {
      "type": "object",
