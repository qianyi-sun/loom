{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loom.example/schemas/task-image-builder-prerequisite-conformance-v2.schema.json",
  "title": "Task-image builder Phase 1 prerequisite conformance evidence v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "collected_at",
    "candidate_sha256",
    "policy_version",
    "policy_sha256",
    "policy_file_sha256",
    "release_name",
    "release_sha256",
    "runtime_manifest_sha256",
    "authority_manifest_sha256",
    "authority_component_digests",
    "production_certification_allowed",
    "certified_nodes",
    "blockers",
    "control_plane_services",
    "clusters"
  ],
  "properties": {
    "schema": {
      "const": "loom.task-image-builder-prerequisite-conformance/v2"
    },
    "schema_version": {
      "const": 2
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "candidate_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "policy_version": {
      "const": "task-image-builder-prerequisites-v1"
    },
    "policy_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "policy_file_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "release_name": {
      "const": "host-release-v2"
    },
    "release_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "runtime_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "authority_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "authority_component_digests": {
      "$ref": "#/$defs/authorityComponentDigests"
    },
    "production_certification_allowed": {
      "const": false
    },
    "certified_nodes": {
      "type": "array",
      "maxItems": 0
    },
    "blockers": {
      "type": "array",
      "prefixItems": [
        {
          "const": "phase2_guard_provider_release_missing"
        }
      ],
      "minItems": 1,
      "maxItems": 1
    },
    "control_plane_services": {
      "$ref": "#/$defs/controlPlaneServices"
    },
    "clusters": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/cluster"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "authorityComponentDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_manifest_parser",
        "host_bundle_verifier",
        "host_converger",
        "node_prerequisite_installer",
        "slurm_bash_converger",
        "controller_identity_installer",
        "slurm_readback_parser",
        "slurm_receipt_producer",
        "node_maintenance_producer",
        "evidence_collector",
        "conformance_verifier"
      ],
      "properties": {
        "authority_manifest_parser": {"$ref": "#/$defs/sha256"},
        "host_bundle_verifier": {"$ref": "#/$defs/sha256"},
        "host_converger": {"$ref": "#/$defs/sha256"},
        "node_prerequisite_installer": {"$ref": "#/$defs/sha256"},
        "slurm_bash_converger": {"$ref": "#/$defs/sha256"},
        "controller_identity_installer": {"$ref": "#/$defs/sha256"},
        "slurm_readback_parser": {"$ref": "#/$defs/sha256"},
        "slurm_receipt_producer": {"$ref": "#/$defs/sha256"},
        "node_maintenance_producer": {"$ref": "#/$defs/sha256"},
        "evidence_collector": {"$ref": "#/$defs/sha256"},
        "conformance_verifier": {"$ref": "#/$defs/sha256"}
      }
    },
    "nodeNames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/name"
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "document"],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "document": {
          "type": "object",
          "minProperties": 1
        }
      }
    },
    "commandReadback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "returncode", "stdout", "stderr"],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "returncode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "stdout": {
          "type": "string",
          "maxLength": 1048576
        },
        "stderr": {
          "type": "string",
          "maxLength": 1048576
        }
      }
    },
    "fileReadback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "contents", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/[^\\u0000]{1,255}$"
        },
        "contents": {
          "type": "string",
          "maxLength": 4096
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "kernelRaw": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unprivileged_user_namespaces",
        "pidfd_open",
        "sealed_memfd",
        "clone3_into_cgroup",
        "cgroup_mount",
        "bpffs_mount",
        "bpffs_metadata",
        "controllers",
        "delegation"
      ],
      "properties": {
        "unprivileged_user_namespaces": {"$ref": "#/$defs/commandReadback"},
        "pidfd_open": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pid", "flags", "outcome"],
          "properties": {
            "pid": {"$ref": "#/$defs/positiveInteger"},
            "flags": {"const": 0},
            "outcome": {"const": "opened"}
          }
        },
        "sealed_memfd": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required_seals", "observed_seals", "outcome"],
          "properties": {
            "required_seals": {"const": 15},
            "observed_seals": {"const": 15},
            "outcome": {"const": "sealed"}
          }
        },
        "clone3_into_cgroup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["flags", "cgroup_fd", "returncode", "errno", "errno_name"],
          "properties": {
            "flags": {"const": "CLONE_INTO_CGROUP"},
            "cgroup_fd": {"const": -1},
            "returncode": {"const": -1},
            "errno": {"const": 9},
            "errno_name": {"const": "EBADF"}
          }
        },
        "cgroup_mount": {"$ref": "#/$defs/commandReadback"},
        "bpffs_mount": {"$ref": "#/$defs/commandReadback"},
        "bpffs_metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "uid", "gid", "mode"],
          "properties": {
            "path": {"const": "/sys/fs/bpf"},
            "uid": {"const": 0},
            "gid": {"const": 0},
            "mode": {"const": "0700"}
          }
        },
        "controllers": {"$ref": "#/$defs/fileReadback"},
        "delegation": {"$ref": "#/$defs/fileReadback"}
      }
    },
    "storageRaw": {
      "type": "object",
      "additionalProperties": false,
      "required": ["findmnt", "lsblk", "jobs_root", "lsattr", "repquota", "cleanup"],
      "properties": {
        "findmnt": {"$ref": "#/$defs/commandReadback"},
        "lsblk": {"$ref": "#/$defs/commandReadback"},
        "jobs_root": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "uid", "gid", "mode", "entries"],
          "properties": {
            "path": {"const": "/var/lib/loom-task-builder/jobs"},
            "uid": {"const": 993},
            "gid": {"const": 980},
            "mode": {"const": "0700"},
            "entries": {"type": "array", "maxItems": 0}
          }
        },
        "lsattr": {"$ref": "#/$defs/commandReadback"},
        "repquota": {"$ref": "#/$defs/commandReadback"},
        "cleanup": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command",
            "returncode",
            "stdout",
            "stderr",
            "processes_absent",
            "mounts_absent",
            "job_directory_absent"
          ],
          "properties": {
            "command": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
            "returncode": {"const": 0},
            "stdout": {"type": "string", "maxLength": 1048576},
            "stderr": {"const": ""},
            "processes_absent": {"const": true},
            "mounts_absent": {"const": true},
            "job_directory_absent": {"const": true}
          }
        }
      }
    },
    "packageSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os_id",
        "version_id",
        "snapshot",
        "suites",
        "component",
        "signer_fingerprint",
        "keyring_sha256"
      ],
      "properties": {
        "os_id": {
          "const": "ubuntu"
        },
        "version_id": {
          "const": "24.04"
        },
        "snapshot": {
          "const": "20260820T000000Z"
        },
        "suites": {
          "type": "array",
          "prefixItems": [
            {"const": "noble"},
            {"const": "noble-updates"}
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "component": {
          "const": "main"
        },
        "signer_fingerprint": {
          "type": "string",
          "pattern": "^[A-F0-9]{40}$"
        },
        "keyring_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "installedPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "source_suite",
        "version",
        "architecture",
        "filename",
        "size",
        "artifact_sha256"
      ],
      "properties": {
        "name": {
          "enum": ["libsubid4", "quota", "uidmap"]
        },
        "source_suite": {
          "enum": ["noble", "noble-updates"]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "architecture": {
          "enum": ["amd64", "arm64"]
        },
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^/][^\\u0000]*\\.deb$"
        },
        "size": {
          "$ref": "#/$defs/positiveInteger"
        },
        "artifact_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "allOf": [
        {
          "if": {"properties": {"name": {"const": "quota"}}},
          "then": {"properties": {"source_suite": {"const": "noble"}}}
        },
        {
          "if": {"properties": {"name": {"enum": ["libsubid4", "uidmap"]}}},
          "then": {"properties": {"source_suite": {"const": "noble-updates"}}}
        }
      ]
    },
    "uidMapHelper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "uid",
        "gid",
        "mode",
        "sha256",
        "file_capabilities"
      ],
      "properties": {
        "path": {
          "enum": ["/usr/bin/newgidmap", "/usr/bin/newuidmap"]
        },
        "uid": {
          "const": 0
        },
        "gid": {
          "const": 0
        },
        "mode": {
          "const": "4755"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "file_capabilities": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "packages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "installed", "helpers"],
      "properties": {
        "source": {
          "$ref": "#/$defs/packageSource"
        },
        "installed": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/installedPackage"
          }
        },
        "helpers": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/uidMapHelper"
          }
        }
      }
    },
    "quotaReadback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storage_root_exists",
        "storage_root_uid",
        "storage_root_gid",
        "storage_root_mode",
        "storage_root_entries",
        "project_id",
        "project_inherit",
        "block_used",
        "block_soft_limit",
        "block_hard_limit",
        "inode_used",
        "inode_soft_limit",
        "inode_hard_limit"
      ],
      "properties": {
        "storage_root_exists": {
          "const": true
        },
        "storage_root_uid": {
          "const": 993
        },
        "storage_root_gid": {
          "const": 980
        },
        "storage_root_mode": {
          "const": 448
        },
        "storage_root_entries": {
          "type": "array",
          "maxItems": 0
        },
        "project_id": {
          "const": 300993
        },
        "project_inherit": {
          "const": true
        },
        "block_used": {
          "type": "integer",
          "minimum": 0
        },
        "block_soft_limit": {
          "const": 0
        },
        "block_hard_limit": {
          "const": 104857600
        },
        "inode_used": {
          "type": "integer",
          "minimum": 0
        },
        "inode_soft_limit": {
          "const": 0
        },
        "inode_hard_limit": {
          "const": 1000000
        }
      }
    },
    "slurmCgroupReadback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "contents"],
      "properties": {
        "path": {
          "const": "/etc/slurm/cgroup.conf"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "contents": {
          "const": "CgroupPlugin=autodetect\nConstrainCores=yes\nConstrainRAMSpace=yes\nConstrainSwapSpace=yes\nConstrainDevices=yes\n"
        }
      }
    },
    "controlPlaneServices": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_scoped_renewable_credential_broker",
        "reference_aware_registry_retention",
        "publication_signer",
        "publication_verification_keyset_lifecycle"
      ],
      "properties": {
        "repository_scoped_renewable_credential_broker": {
          "const": true
        },
        "reference_aware_registry_retention": {
          "const": true
        },
        "publication_signer": {
          "const": true
        },
        "publication_verification_keyset_lifecycle": {
          "const": true
        }
      }
    },
    "partition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "priority_tier", "nodes"],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "priority_tier": {
          "$ref": "#/$defs/positiveInteger"
        },
        "nodes": {
          "$ref": "#/$defs/nodeNames"
        }
      }
    },
    "qos": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "flags",
        "max_jobs_per_user",
        "max_submit_jobs_per_user",
        "max_wall",
        "group_tres"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "flags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "max_jobs_per_user": {
          "$ref": "#/$defs/positiveInteger"
        },
        "max_submit_jobs_per_user": {
          "$ref": "#/$defs/positiveInteger"
        },
        "max_wall": {
          "type": "string",
          "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}$"
        },
        "group_tres": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpu", "memory_mib", "nodes"],
          "properties": {
            "cpu": {
              "$ref": "#/$defs/positiveInteger"
            },
            "memory_mib": {
              "$ref": "#/$defs/positiveInteger"
            },
            "nodes": {
              "$ref": "#/$defs/positiveInteger"
            }
          }
        }
      }
    },
    "association": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user", "account", "partition", "qos", "default_qos"],
      "properties": {
        "user": {
          "$ref": "#/$defs/name"
        },
        "account": {
          "$ref": "#/$defs/name"
        },
        "partition": {
          "$ref": "#/$defs/name"
        },
        "qos": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "default_qos": {
          "$ref": "#/$defs/name"
        }
      }
    },
    "controllerIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user",
        "uid",
        "group",
        "gid",
        "home",
        "shell",
        "supplementary_groups"
      ],
      "properties": {
        "user": {
          "$ref": "#/$defs/name"
        },
        "uid": {
          "$ref": "#/$defs/positiveInteger"
        },
        "group": {
          "$ref": "#/$defs/name"
        },
        "gid": {
          "$ref": "#/$defs/positiveInteger"
        },
        "home": {
          "type": "string",
          "pattern": "^/[^\\u0000]{0,255}$"
        },
        "shell": {
          "type": "string",
          "pattern": "^/[^\\u0000]{0,255}$"
        },
        "supplementary_groups": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "address": {
      "type": "string",
      "anyOf": [
        {
          "format": "ipv4"
        },
        {
          "format": "ipv6"
        }
      ]
    },
    "slurmIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_name",
        "node_hostname",
        "node_addr",
        "resolved_addresses",
        "resolution",
        "local_hostnames",
        "local_addresses",
        "readback"
      ],
      "properties": {
        "node_name": {
          "$ref": "#/$defs/name"
        },
        "node_hostname": {
          "$ref": "#/$defs/name"
        },
        "node_addr": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "resolved_addresses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/address"
          }
        },
        "resolution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["query", "addresses"],
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "addresses": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/address"
              }
            }
          }
        },
        "local_hostnames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "local_addresses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/address"
          }
        },
        "readback": {
          "$ref": "#/$defs/commandReadback"
        }
      }
    },
    "legacyQos": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "flags",
        "priority",
        "max_jobs_per_user",
        "max_submit_jobs_per_user",
        "max_wall",
        "group_tres"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "flags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "priority": {
          "type": "integer",
          "minimum": 0
        },
        "max_jobs_per_user": {
          "$ref": "#/$defs/positiveInteger"
        },
        "max_submit_jobs_per_user": {
          "$ref": "#/$defs/positiveInteger"
        },
        "max_wall": {
          "type": "string",
          "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}$"
        },
        "group_tres": {
          "type": "object",
          "additionalProperties": false,
          "maxProperties": 0
        }
      }
    },
    "legacyAssociation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cluster", "account", "user", "qos", "default_qos"],
      "properties": {
        "cluster": {
          "$ref": "#/$defs/name"
        },
        "account": {
          "$ref": "#/$defs/name"
        },
        "user": {
          "$ref": "#/$defs/name"
        },
        "qos": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "default_qos": {
          "$ref": "#/$defs/name"
        }
      }
    },
    "legacyReservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "node",
        "partition",
        "users",
        "accounts",
        "state",
        "flags"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "node": {
          "$ref": "#/$defs/name"
        },
        "partition": {
          "$ref": "#/$defs/name"
        },
        "users": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "accounts": {
          "type": "array",
          "minItems": 1,
